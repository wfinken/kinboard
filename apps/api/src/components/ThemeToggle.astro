---
import Icon from './Icon.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle light and dark theme"
  class={`h-10 w-10 shrink-0 rounded-full bg-surface-2 hover:bg-surface-3 ${className}`}
>
  <Icon name="sun" class="theme-icon-sun" />
  <Icon name="moon" class="theme-icon-moon" />
</button>

<style>
  button {
    display: grid;
    place-items: center;
  }
  button :global(.kb-icon) {
    grid-area: 1 / 1;
  }
</style>

<script>
  const STORAGE_KEY = 'kinboard-theme';

  function currentTheme(): 'light' | 'dark' {
    return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = currentTheme() === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        // Private browsing etc. — the toggle still works for this page view.
      }
    });
  });
</script>
