---
import Layout from '../layouts/Layout.astro';
import ClockWidget from '../components/ClockWidget.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import CalendarWidget from '../components/CalendarWidget.astro';
import TaskList from '../components/TaskList.astro';
import MealPlanWidget from '../components/MealPlanWidget.astro';
import StickyNotes from '../components/StickyNotes.astro';
import AllowanceWidget from '../components/AllowanceWidget.astro';
import AvailabilityWidget from '../components/AvailabilityWidget.astro';
import LatestWidget from '../components/LatestWidget.astro';
import { getDashboardSettings, getUserDashboardLayout, WIDGET_LABELS } from '../lib/settings';
import { getPermissions } from '../lib/permissions';
import { randomFooterMessage, randomHeartColor } from '../lib/footer-messages';
import Icon from '../components/Icon.astro';
import type { DashboardWidgetId, PermissionFeature } from '../db/schema';

const footerMessage = randomFooterMessage();
const heartColor = randomHeartColor();

// Middleware requires a signed-in session for every route but /login, so
// reaching this point always means Astro.locals.session is set — a
// signed-in user with no family yet still needs onboarding.
const familyId = Astro.locals.familyId;
if (!familyId) return Astro.redirect('/welcome');
Astro.response.headers.set('Cache-Control', 'private, no-store');
const settings = await getDashboardSettings(familyId);
const personalLayout = await getUserDashboardLayout(Astro.locals.session!.user!.id, familyId, settings);
const perms = await getPermissions(familyId, Astro.locals.session!.user!.id);

const WIDGET_COMPONENTS: Record<DashboardWidgetId, (_props: any) => unknown> = {
  clock: ClockWidget,
  weather: WeatherWidget,
  latest: LatestWidget,
  calendar: CalendarWidget,
  meals: MealPlanWidget,
  chores: TaskList,
  availability: AvailabilityWidget,
  allowance: AllowanceWidget,
  notes: StickyNotes,
};
// Widgets tied to a gated feature — clock/weather/meals have no create
// action here and aren't in this map, so they're never hidden or props'd.
const WIDGET_FEATURES: Partial<Record<DashboardWidgetId, PermissionFeature>> = {
  calendar: 'calendars',
  chores: 'chores',
  availability: 'chores',
  allowance: 'allowance',
  notes: 'notes',
};
const WIDGET_PROPS: Partial<Record<DashboardWidgetId, Record<string, unknown>>> = {
  chores: { canCreate: perms.chores.create },
  notes: { canCreate: perms.notes.create },
};
const visibleWidgetOrder = personalLayout.widgetOrder.filter((id) => settings.widgetOrder.includes(id)).filter((id) => {
  const feature = WIDGET_FEATURES[id];
  return !feature || perms[feature].read;
});
const enabled = new Set(visibleWidgetOrder);
const orderedWidgets = visibleWidgetOrder.filter((id) => id !== 'clock' && id !== 'weather' && id !== 'latest');
const widgetSizes = personalLayout.widgetSizes;
---

<Layout title="Dashboard" refreshSeconds={settings.refreshSeconds} theme={settings.theme} showControls={false}>
  <main class="wall-dashboard">
    <header class="wall-header">
      <div class="wall-brand"><span class="wall-brand-mark" aria-hidden="true">K.</span><div><p class="wall-eyebrow">YOUR FAMILY, IN SYNC</p><h1>KinBoard</h1></div></div>
          <div class="wall-date" data-wall-date></div>
      <div class="wall-actions dashboard-controls">
        <a href="/app/" class="wall-icon-button" aria-label="Open the web app" title="Open the web app">↗</a>
        <button type="button" data-customize-toggle class="wall-icon-button" aria-label="Customize dashboard" aria-pressed="false" title="Customize dashboard">✎</button>
        <button type="button" data-kiosk-toggle aria-pressed="false" class="wall-icon-button" aria-label="Toggle full screen"><Icon name="maximize" /></button>
        <a href="/admin" class="wall-icon-button" aria-label="Open family settings"><Icon name="settings" /></a>
        <button type="button" data-theme-toggle class="wall-icon-button" aria-label="Toggle light and dark theme">
          <Icon name="sun" class="theme-icon-sun" />
          <Icon name="moon" class="theme-icon-moon" />
        </button>
        <button type="button" data-hide-header class="wall-icon-button" aria-label="Hide this bar — just show the dashboard"><Icon name="chevron-up" /></button>
        <a href="/api/auth/signout" class="wall-icon-button" aria-label="Sign out"><Icon name="log-out" /></a>
      </div>
    </header>
    <section class="dashboard-customize" data-customize-panel hidden aria-label="Customize dashboard widgets">
      <div><strong>Customize your dashboard</strong><p>Drag widgets to arrange them. Choose a size for each one.</p></div>
      <button type="button" data-customize-done class="dashboard-customize-done">Done</button>
    </section>
    <button type="button" data-show-header class="wall-reveal-tab" aria-label="Show the top bar"><Icon name="chevron-down" /></button>

    <section class="wall-hero-row" aria-label="Time, weather, and latest activity">
      {enabled.has('clock') && <div class="wall-clock-card"><div class="wall-card-kicker"><span class="wall-status-dot"></span> RIGHT NOW</div><ClockWidget /></div>}
      {enabled.has('weather') && <div class="wall-weather-card"><div class="wall-card-kicker">⛅ WEATHER NEAR HOME</div><WeatherWidget /></div>}
      {enabled.has('latest') && <div class="wall-latest-card" data-hero-widget="latest" data-size={widgetSizes.latest ?? '2x1'}><div class="hero-widget-customize-tools" aria-label="Latest layout controls"><strong>Latest</strong><label>Size <select data-hero-widget-size="latest" aria-label="Latest size"><option value="1x1" selected={(widgetSizes.latest ?? '2x1') === '1x1'}>Small · Single</option><option value="2x1" selected={(widgetSizes.latest ?? '2x1') === '2x1'}>Medium · Single</option><option value="3x1" selected={widgetSizes.latest === '3x1'}>Large · Single</option><option value="1x2" selected={widgetSizes.latest === '1x2'}>Small · Double</option><option value="2x2" selected={widgetSizes.latest === '2x2'}>Medium · Double</option></select></label></div><LatestWidget /></div>}
    </section>

    <div class="wall-widget-grid" data-widget-grid>
      {orderedWidgets.map((id) => {
        const Widget = WIDGET_COMPONENTS[id];
        return <div class="wall-widget" data-widget={id} data-size={widgetSizes[id] ?? '1x1'} draggable="false">
          <div class="widget-customize-tools" aria-label={`${WIDGET_LABELS[id]} layout controls`}>
            <span class="widget-drag-handle" aria-hidden="true">⠿</span>
            <strong>{WIDGET_LABELS[id]}</strong>
            <label>Size <select data-widget-size={id} aria-label={`${WIDGET_LABELS[id]} size`}>
              <option value="1x1" selected={(widgetSizes[id] ?? '1x1') === '1x1'}>Small · Single</option>
              <option value="2x1" selected={widgetSizes[id] === '2x1'}>Medium · Single</option>
              <option value="3x1" selected={widgetSizes[id] === '3x1'}>Large · Single</option>
              <option value="1x2" selected={widgetSizes[id] === '1x2'}>Small · Double</option>
              <option value="2x2" selected={widgetSizes[id] === '2x2'}>Medium · Double</option>
            </select></label>
            <button type="button" data-move-widget="up" aria-label={`Move ${WIDGET_LABELS[id]} earlier`}>↑</button>
            <button type="button" data-move-widget="down" aria-label={`Move ${WIDGET_LABELS[id]} later`}>↓</button>
          </div>
          <Widget {...(id === 'calendar' ? { canCreate: perms.calendars.create, canDelete: perms.calendars.delete } : (WIDGET_PROPS[id] ?? {}))} />
        </div>;
      })}
    </div>

    {settings.widgetOrder.length === 0 && <p class="wall-empty">No widgets enabled. Configure this dashboard from <a href="/admin/layout">Display settings</a>.</p>}
    <footer class="wall-footer"><span>Made with <b style={`color:${heartColor}`}>♥</b> {footerMessage}</span><span>Family dashboard</span></footer>
  </main>
</Layout>

<script>
  const grid = document.querySelector<HTMLElement>('[data-widget-grid]');
  const panel = document.querySelector<HTMLElement>('[data-customize-panel]');
  const customizeToggle = document.querySelector<HTMLButtonElement>('[data-customize-toggle]');
  const setCustomize = (active: boolean) => {
    document.documentElement.classList.toggle('dashboard-customizing', active);
    if (panel) panel.hidden = !active;
    customizeToggle?.setAttribute('aria-pressed', String(active));
    document.querySelectorAll<HTMLElement>('[data-widget]').forEach((widget) => widget.draggable = active);
  };
  customizeToggle?.addEventListener('click', () => setCustomize(!document.documentElement.classList.contains('dashboard-customizing')));
  document.querySelector('[data-customize-done]')?.addEventListener('click', () => setCustomize(false));

  const widgetList = () => Array.from(grid?.querySelectorAll<HTMLElement>('[data-widget]') ?? []);
  const saveLayout = async () => {
    const widgets = widgetList();
    const widgetOrder = widgets.map((widget) => widget.dataset.widget).filter(Boolean);
    const widgetSizes = Object.fromEntries(widgets.map((widget) => [widget.dataset.widget, widget.dataset.size ?? '1x1']));
    document.querySelectorAll<HTMLElement>('[data-hero-widget]').forEach((widget) => {
      const id = widget.dataset.heroWidget;
      if (id) widgetSizes[id] = widget.dataset.size ?? '2x1';
    });
    try {
      const response = await fetch('/api/dashboard/layout', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ widgetOrder, widgetSizes }),
      });
      if (!response.ok) throw new Error('Save failed');
    } catch {
      if (panel) panel.dataset.saveError = 'true';
    }
  };
  document.querySelectorAll<HTMLSelectElement & Element>('[data-widget-size]').forEach((select) => {
    select.addEventListener('change', () => {
      const widget = select.closest<HTMLElement>('[data-widget]');
      if (widget) widget.dataset.size = select.value;
      void saveLayout();
    });
  });
  document.querySelectorAll<HTMLSelectElement & Element>('[data-hero-widget-size]').forEach((select) => {
    select.addEventListener('change', () => {
      const widget = select.closest<HTMLElement>('[data-hero-widget]');
      if (widget) widget.dataset.size = select.value;
      void saveLayout();
    });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-move-widget]').forEach((button) => {
    button.addEventListener('click', () => {
      const widget = button.closest<HTMLElement>('[data-widget]');
      if (!widget || !grid) return;
      if (button.dataset.moveWidget === 'up' && widget.previousElementSibling) grid.insertBefore(widget, widget.previousElementSibling);
      if (button.dataset.moveWidget === 'down' && widget.nextElementSibling) grid.insertBefore(widget.nextElementSibling, widget);
      void saveLayout();
    });
  });
  let draggedWidget: HTMLElement | null = null;
  grid?.addEventListener('dragstart', (event) => {
    const target = event.target as HTMLElement;
    draggedWidget = target.closest<HTMLElement>('[data-widget]');
    if (!draggedWidget || !event.dataTransfer) return;
    event.dataTransfer.effectAllowed = 'move';
    event.dataTransfer.setData('text/plain', draggedWidget.dataset.widget ?? '');
    draggedWidget.classList.add('is-dragging');
  });
  grid?.addEventListener('dragover', (event) => {
    event.preventDefault();
    const target = event.target as HTMLElement;
    const over = target.closest<HTMLElement>('[data-widget]');
    if (!draggedWidget || !over || over === draggedWidget || !grid) return;
    const bounds = over.getBoundingClientRect();
    const after = event.clientY > bounds.top + bounds.height / 2;
    grid.insertBefore(draggedWidget, after ? over.nextSibling : over);
  });
  grid?.addEventListener('drop', (event) => { event.preventDefault(); void saveLayout(); });
  grid?.addEventListener('dragend', () => { draggedWidget?.classList.remove('is-dragging'); draggedWidget = null; });

  const date = document.querySelector<HTMLElement>('[data-wall-date]');
  if (date) date.textContent = new Date().toLocaleDateString([], { weekday: 'long', month: 'long', day: 'numeric' });

  // Dashboard reloads the whole page on a timer (see refreshSeconds), so
  // this has to be re-applied from localStorage on every load rather than
  // just toggled in memory — same pattern as the theme toggle below.
  const HEADER_HIDDEN_KEY = 'kinboard-header-hidden';
  const root = document.documentElement;
  const setHeaderHidden = (hidden: boolean) => {
    root.classList.toggle('wall-header-hidden', hidden);
    try {
      if (hidden) localStorage.setItem(HEADER_HIDDEN_KEY, '1');
      else localStorage.removeItem(HEADER_HIDDEN_KEY);
    } catch {}
  };
  document.querySelector('[data-hide-header]')?.addEventListener('click', () => setHeaderHidden(true));
  document.querySelector('[data-show-header]')?.addEventListener('click', () => setHeaderHidden(false));
  try { if (localStorage.getItem(HEADER_HIDDEN_KEY) === '1') setHeaderHidden(true); } catch {}

  const THEME_STORAGE_KEY = 'kinboard-theme';
  const currentTheme = (): 'light' | 'dark' => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = currentTheme() === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem(THEME_STORAGE_KEY, next); } catch {}
    });
  });
</script>
