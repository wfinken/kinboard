---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import type { DashboardTheme } from '../lib/settings';

interface Props {
  title: string;
  /** Seconds between full-page reloads. Zero-JS refresh via <meta>, works on
   *  even the oldest smart TV browsers. Omit to disable. */
  refreshSeconds?: number;
  /** Household default from dashboard_settings; a per-device override can
   *  still win via localStorage (see ThemeInit/ThemeToggle). */
  theme?: DashboardTheme;
  /** Hide dashboard-only controls on auth and onboarding screens. */
  minimal?: boolean;
  /** The redesigned dashboard renders its own header controls. */
  showControls?: boolean;
}

const { title, refreshSeconds, theme = 'dark', minimal = false, showControls = true } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={theme} data-minimal={minimal ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700&display=swap" rel="stylesheet" />
    <ThemeInit serverTheme={theme} />
    {refreshSeconds ? <meta http-equiv="refresh" content={String(refreshSeconds)} /> : null}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · KinBoard</title>
  </head>
  <body class="min-h-screen bg-page text-fg font-sans">
    {!minimal && showControls && <div class="fixed right-4 top-4 z-50 flex items-center gap-2 dashboard-controls">
      <button type="button" data-kiosk-toggle aria-pressed="false" class="rounded-full bg-surface-2 px-4 py-2 text-sm font-medium hover:bg-surface-3">⛶ Kiosk</button>
      <a
        href="/admin"
        aria-label="Open admin settings"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface-2 text-lg hover:bg-surface-3"
      >
        <span aria-hidden="true">⚙️</span>
      </a>
      <ThemeToggle />
    </div>}
    <slot />
    <div class="ambient-saver" aria-hidden="true"><span>KinBoard</span><time data-saver-clock></time></div>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector('[data-kiosk-toggle]');
        let saverTimer;
        const enable = async () => {
          root.classList.add('kiosk-mode');
          try { if (!document.fullscreenElement) await document.documentElement.requestFullscreen(); } catch {}
          toggle?.setAttribute('aria-pressed', 'true');
          localStorage.setItem('kinboard-kiosk', '1');
        };
        const disable = async () => {
          root.classList.remove('kiosk-mode', 'ambient-saver-active');
          try { if (document.fullscreenElement) await document.exitFullscreen(); } catch {}
          toggle?.setAttribute('aria-pressed', 'false');
          localStorage.removeItem('kinboard-kiosk');
        };
        toggle?.addEventListener('click', () => root.classList.contains('kiosk-mode') ? disable() : enable());
        document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && root.classList.contains('kiosk-mode')) disable(); });
        document.addEventListener('fullscreenchange', () => { if (!document.fullscreenElement && root.classList.contains('kiosk-mode')) disable(); });
        try { if (localStorage.getItem('kinboard-kiosk') === '1') enable(); } catch {}
        const updateClock = () => { const node = document.querySelector('[data-saver-clock]'); if (node) node.textContent = new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }); };
        updateClock(); setInterval(updateClock, 60_000);
        const activity = () => { root.classList.remove('ambient-saver-active'); clearTimeout(saverTimer); if (!root.hasAttribute('data-minimal')) saverTimer = setTimeout(() => root.classList.add('ambient-saver-active'), 120_000); };
        ['pointerdown', 'keydown', 'touchstart'].forEach((name) => document.addEventListener(name, activity, { passive: true })); activity();
        // Background tabs may have their meta refresh timer throttled or
        // suspended. Reload the kiosk dashboard as soon as it is shown again.
        let wasHidden = document.visibilityState === 'hidden';
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') wasHidden = true;
          else if (wasHidden && document.querySelector('meta[http-equiv="refresh"]')) location.reload();
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  .kiosk-mode .dashboard-controls { opacity: 0; pointer-events: none; transition: opacity .25s ease; }
  .kiosk-mode .dashboard-controls:hover, .kiosk-mode .dashboard-controls:focus-within { opacity: 1; pointer-events: auto; }
  /* The dashboard's own header has an explicit show/hide toggle (see
     index.astro's wall-header-hidden/wall-reveal-tab), which is the
     decluttering control there now — the hover-based fade above doesn't
     mix with it (or with touch, which has no real hover state): revealing
     the header via the tab would leave its buttons hover-gated and
     invisible until actually touched again. */
  .kiosk-mode .wall-header .dashboard-controls { opacity: 1; pointer-events: auto; }
  .ambient-saver { position: fixed; inset: 0; display: none; align-items: center; justify-content: center; gap: 1rem; background: #080a0e; color: #64748b; font-size: clamp(1.5rem, 4vw, 4rem); z-index: 100; }
  .ambient-saver-active .ambient-saver { display: flex; }
  .ambient-saver time { font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: reduce) { .kiosk-mode .dashboard-controls { transition: none; } }
</style>
