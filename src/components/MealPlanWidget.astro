---
import { db } from '../db/client';
import { meals } from '../db/schema';
import { gte, lte, and } from 'drizzle-orm';

const today = new Date();
const todayKey = today.toISOString().slice(0, 10);
const weekEnd = new Date(today);
weekEnd.setDate(weekEnd.getDate() + 6);
const weekEndKey = weekEnd.toISOString().slice(0, 10);

const weekMeals = await db.query.meals.findMany({
  where: and(gte(meals.date, todayKey), lte(meals.date, weekEndKey)),
});

const mealsByDate = weekMeals.reduce<Record<string, Record<string, string>>>((acc, meal) => {
  acc[meal.date] ??= {};
  acc[meal.date][meal.mealType] = meal.description;
  return acc;
}, {});

const todayMeals = mealsByDate[todayKey] ?? {};

const weekDays = Array.from({ length: 7 }, (_, i) => {
  const d = new Date(today);
  d.setDate(d.getDate() + i);
  return d.toISOString().slice(0, 10);
});

const MEAL_ICONS = { breakfast: '🍳', lunch: '🥪', dinner: '🍽️' } as const;
---

<div class="rounded-3xl bg-surface p-5 shadow-card sm:p-6">
  <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold">
    <span aria-hidden="true">🍽️</span> Meals Today
  </h2>
  <div class="grid grid-cols-3 gap-3 text-center">
    {
      (['breakfast', 'lunch', 'dinner'] as const).map((type) => (
        <div class="rounded-2xl bg-surface-2/60 p-3">
          <div class="text-lg">{MEAL_ICONS[type]}</div>
          <div class="mt-0.5 text-xs uppercase tracking-wide text-fg-subtle">{type}</div>
          <div class="mt-1 text-sm">{todayMeals[type] || '—'}</div>
        </div>
      ))
    }
  </div>
  <h3 class="mb-2 mt-5 text-sm font-medium uppercase tracking-wide text-fg-subtle">Week Ahead</h3>
  <ul class="space-y-1 text-sm">
    {
      weekDays.slice(1).map((date) => {
        const dayMeals = mealsByDate[date];
        const summary = dayMeals
          ? Object.values(dayMeals).filter(Boolean).join(' · ')
          : 'Not planned';
        return (
          <li class="flex justify-between gap-4">
            <span class="font-medium">
              {new Date(date).toLocaleDateString([], { weekday: 'short' })}
            </span>
            <span class="truncate text-fg-muted">{summary}</span>
          </li>
        );
      })
    }
  </ul>
</div>
