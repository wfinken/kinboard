---
const familyId = Astro.locals.familyId!;
import { db } from '../db/client';
import { meals } from '../db/schema';
import { gte, lte, and, eq } from 'drizzle-orm';
import { parseDateKey, householdTimezone, zonedCalendarDate, dateKeyUTC } from '../lib/dates';

const today = zonedCalendarDate(new Date(), householdTimezone());
const todayKey = dateKeyUTC(today);
const weekEnd = new Date(today);
weekEnd.setUTCDate(weekEnd.getUTCDate() + 6);
const weekEndKey = dateKeyUTC(weekEnd);

const weekMeals = await db.query.meals.findMany({
  where: and(eq(meals.familyId, familyId), gte(meals.date, todayKey), lte(meals.date, weekEndKey)),
});

const MEAL_ICONS = { breakfast: '🍳', lunch: '🥪', dinner: '🍽️' } as const;
const MEAL_LABELS = { breakfast: 'Breakfast', lunch: 'Lunch', dinner: 'Dinner' } as const;
---

<div class="rounded-3xl bg-surface p-5 shadow-card sm:p-6">
  <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold">
    <span aria-hidden="true">🍽️</span> Meal Plan
  </h2>
  {weekMeals.length ? <ul class="space-y-2">
    {weekMeals.map((meal) => {
      const isToday = meal.date === todayKey;
      const day = parseDateKey(meal.date).toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
      return <li class="flex items-center gap-3 rounded-xl bg-surface-2/60 px-3 py-2.5">
        <span aria-hidden="true" class="text-lg">{MEAL_ICONS[meal.mealType]}</span>
        <span class="min-w-0 flex-1"><span class="block truncate text-sm font-medium">{meal.description}</span><span class="text-xs text-fg-subtle">{isToday ? 'Today' : day} · {MEAL_LABELS[meal.mealType]}</span></span>
      </li>;
    })}
  </ul> : <div class="rounded-2xl bg-surface-2/60 px-4 py-6 text-center"><p class="text-sm font-medium">No meals planned this week</p><p class="mt-1 text-xs text-fg-muted">Add a meal whenever you decide what’s on the menu.</p></div>}
  <a href="/admin/meals" class="mt-4 inline-flex text-sm font-medium text-accent hover:underline">Plan a meal <span class="ml-1" aria-hidden="true">→</span></a>
</div>
