---
import { fetchUpcomingEvents, type CalendarEvent } from '../lib/google-calendar';
import { householdTimezone, zonedCalendarDate, zonedDateKey, dateKeyUTC } from '../lib/dates';
import { getDashboardSettings } from '../lib/settings';
import { db } from '../db/client';

const DAY_COUNT = 4;

const ownerId = Astro.locals.session?.user?.id ?? null;
const members = await db.query.householdMembers.findMany({ orderBy: (m, { asc }) => asc(m.sortOrder) });

const now = new Date();
const rangeEnd = new Date(now);
rangeEnd.setDate(rangeEnd.getDate() + DAY_COUNT);

const events = ownerId ? await fetchUpcomingEvents(ownerId, now, rangeEnd) : [];

// "Today" for the household, not the server (the Worker runs in UTC
// regardless of where the household actually is) — see lib/dates.ts.
const settings = await getDashboardSettings();
const timezone = settings.timezone === 'auto' ? householdTimezone() : settings.timezone;
const today = zonedCalendarDate(now, timezone);
const days = Array.from({ length: DAY_COUNT }, (_, i) => {
  const d = new Date(today);
  d.setUTCDate(d.getUTCDate() + i);
  return d;
});

// `days` entries are calendar-only dates normalized to UTC midnight (see
// zonedCalendarDate), so dateKeyUTC/toISOString on them is exact — no
// server-timezone shift.
const dateKey = dateKeyUTC;

function hasTimezone(value: string) {
  return /(?:Z|[+-]\d{2}:?\d{2})$/.test(value);
}

function timeLabel(event: CalendarEvent, timezone: string) {
  if (event.allDay) return 'All day';
  // Local events are stored as household wall-clock values from datetime-local;
  // Google events carry an offset/Z and should be converted into the household zone.
  if (!hasTimezone(event.start)) {
    const [hour, minute] = event.start.slice(11, 16).split(':').map(Number);
    const suffix = hour >= 12 ? 'PM' : 'AM';
    return `${hour % 12 || 12}:${String(minute).padStart(2, '0')} ${suffix}`;
  }
  return new Date(event.start).toLocaleTimeString([], {
    timeZone: timezone,
    hour: 'numeric',
    minute: '2-digit',
  });
}

const eventsByDay = events.reduce<Record<string, CalendarEvent[]>>((acc, event) => {
  const key = event.allDay || !hasTimezone(event.start)
    ? event.start.slice(0, 10)
    : zonedDateKey(new Date(event.start), timezone);
  acc[key] ??= [];
  acc[key].push(event);
  return acc;
}, {});

const todayKey = dateKey(today);
---

<div class="rounded-3xl bg-surface p-5 shadow-card sm:p-6">
  <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold">
    <span aria-hidden="true">📅</span> Calendar
    <button type="button" class="ml-auto rounded-full px-3 py-1.5 text-sm font-medium text-fg-muted hover:bg-surface-2 hover:text-fg" data-open-dialog="calendar-dialog">＋ Add</button>
  </h2>
  {
    !ownerId ? (
      <p class="text-fg-subtle">Connect a Google account in Admin → Calendars to see events.</p>
    ) : (
      <div class="grid grid-cols-4 gap-2 sm:gap-3">
        {days.map((day) => {
          const key = dateKey(day);
          const isToday = key === todayKey;
          const dayEvents = [...(eventsByDay[key] ?? [])].sort((a, b) =>
            a.start.localeCompare(b.start),
          );
          return (
            <div class="min-w-0 rounded-2xl bg-surface-2/60 p-2 sm:p-3">
              <div class="mb-2 text-center">
                <div class="text-[11px] font-semibold uppercase tracking-wide text-fg-subtle">
                  {day.toLocaleDateString([], { weekday: 'short', timeZone: 'UTC' })}
                </div>
                <div
                  class={`mx-auto mt-1 flex h-7 w-7 items-center justify-center rounded-full text-sm font-bold ${isToday ? 'bg-accent text-white' : 'text-fg'}`}
                >
                  {day.getUTCDate()}
                </div>
              </div>
              <div class="space-y-1.5">
                {dayEvents.length === 0 ? (
                  <p class="text-center text-xs text-fg-subtle">No events</p>
                ) : (
                  dayEvents.map((event) => (
                    <div
                      class="min-w-0 rounded-lg border-l-4 px-2 py-1.5 text-xs leading-tight"
                      style={`background-color:${event.color}22; border-color:${event.color}`}
                    >
                      <p class="truncate font-medium">{event.title}</p>
                      {event.memberName && <p class="truncate text-[10px] font-semibold" style={`color:${event.color}`}>{event.memberName}</p>}
                      <p class="truncate text-fg-subtle">{timeLabel(event, timezone)}</p>
                    </div>
                  ))
                )}
              </div>
            </div>
          );
        })}
      </div>
    )
  }
</div>

<dialog id="calendar-dialog" class="w-[min(92vw,28rem)] rounded-3xl bg-surface p-0 text-fg shadow-2xl backdrop:bg-black/60">
  <form method="POST" action="/api/admin/events" class="space-y-4 p-6">
    <input type="hidden" name="returnTo" value="/" />
    <div class="flex items-center justify-between"><h3 class="text-xl font-semibold">Add calendar item</h3><button type="button" class="text-2xl text-fg-muted" data-close-dialog aria-label="Close">×</button></div>
    <input name="title" required autofocus placeholder="What’s happening?" class="w-full rounded-xl border border-line bg-surface-2 px-3 py-3" />
    <label class="flex items-center gap-2 text-sm text-fg-muted"><input type="checkbox" name="allDay" data-all-day /> All day</label>
    <div class="grid grid-cols-2 gap-3"><label class="text-sm text-fg-muted">Starts<input name="start" type="datetime-local" required class="mt-1 w-full rounded-xl border border-line bg-surface-2 px-3 py-2.5" /></label><label class="text-sm text-fg-muted" data-end-wrap>Ends<input name="end" type="datetime-local" required class="mt-1 w-full rounded-xl border border-line bg-surface-2 px-3 py-2.5" /></label></div>
    <label class="block text-sm text-fg-muted">For<select name="memberId" class="mt-1 w-full rounded-xl border border-line bg-surface-2 px-3 py-2.5"><option value="">Everyone</option>{members.map((m) => <option value={m.id}>{m.name}</option>)}</select></label>
    <button class="w-full rounded-xl bg-accent px-4 py-3 font-semibold text-white hover:bg-accent-hover">Add to calendar</button>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#calendar-dialog');
  document.querySelector('[data-open-dialog="calendar-dialog"]')?.addEventListener('click', () => {
    const start = dialog?.querySelector<HTMLInputElement>('[name="start"]');
    const end = dialog?.querySelector<HTMLInputElement>('[name="end"]');
    if (start && !start.value) {
      const now = new Date();
      now.setMinutes(Math.ceil(now.getMinutes() / 15) * 15, 0, 0);
      const later = new Date(now.getTime() + 60 * 60 * 1000);
      const value = (date: Date) => date.toISOString().slice(0, 16);
      start.value = value(now);
      if (end) end.value = value(later);
    }
    dialog?.showModal();
  });
  dialog?.querySelector('[data-close-dialog]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  dialog?.querySelector<HTMLInputElement>('[data-all-day]')?.addEventListener('change', (event) => {
    const allDay = (event.target as HTMLInputElement).checked;
    const start = dialog.querySelector<HTMLInputElement>('[name="start"]');
    const end = dialog.querySelector<HTMLInputElement>('[name="end"]');
    const endWrap = dialog.querySelector<HTMLElement>('[data-end-wrap]');
    if (start) start.type = allDay ? 'date' : 'datetime-local';
    if (end) { end.required = !allDay; end.type = allDay ? 'date' : 'datetime-local'; }
    if (endWrap) endWrap.classList.toggle('hidden', allDay);
  });
</script>
