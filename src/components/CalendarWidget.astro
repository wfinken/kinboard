---
import { getHouseholdOwnerId } from '../lib/household';
import { fetchUpcomingEvents, type CalendarEvent } from '../lib/google-calendar';

const ownerId = await getHouseholdOwnerId();

const now = new Date();
const rangeEnd = new Date(now);
rangeEnd.setDate(rangeEnd.getDate() + 3);

const events = ownerId ? await fetchUpcomingEvents(ownerId, now, rangeEnd) : [];

function dayLabel(dateStr: string) {
  const date = new Date(dateStr);
  const today = new Date();
  const isToday = date.toDateString() === today.toDateString();
  if (isToday) return 'Today';
  return date.toLocaleDateString([], { weekday: 'long', month: 'short', day: 'numeric' });
}

function timeLabel(event: CalendarEvent) {
  if (event.allDay) return 'All day';
  return new Date(event.start).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
}

const groups = events.reduce<Record<string, CalendarEvent[]>>((acc, event) => {
  const key = event.start.slice(0, 10);
  acc[key] ??= [];
  acc[key].push(event);
  return acc;
}, {});
---

<div class="rounded-2xl bg-surface p-6">
  <h2 class="mb-4 text-lg font-semibold text-fg-muted">Upcoming</h2>
  {
    !ownerId ? (
      <p class="text-fg-subtle">Connect a Google account in Admin → Calendars to see events.</p>
    ) : Object.keys(groups).length === 0 ? (
      <p class="text-fg-subtle">Nothing on the calendar for the next 3 days.</p>
    ) : (
      <div class="space-y-5">
        {Object.entries(groups).map(([day, dayEvents]) => (
          <div>
            <div class="mb-2 text-sm font-medium uppercase tracking-wide text-fg-subtle">
              {dayLabel(day)}
            </div>
            <ul class="space-y-2">
              {dayEvents.map((event) => (
                <li class="flex items-center gap-3">
                  <span class="h-3 w-3 shrink-0 rounded-full" style={`background-color:${event.color}`} />
                  <span class="w-20 shrink-0 text-sm text-fg-muted">{timeLabel(event)}</span>
                  <span class="text-lg">{event.title}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )
  }
</div>
