---
const familyId = Astro.locals.familyId!;
import { fetchUpcomingEvents, listWritableFamilyCalendars, type CalendarEvent } from '../lib/google-calendar';
import { householdTimezone, zonedCalendarDate, zonedDateKey, dateKeyUTC } from '../lib/dates';
import { getDashboardSettings } from '../lib/settings';
import { db } from '../db/client';
import CalendarEventForm from './CalendarEventForm.astro';

interface Props { canCreate?: boolean; canDelete?: boolean }
const { canCreate = true, canDelete = true } = Astro.props;

// Today gets its own row above the grid, so the grid itself covers the
// DAY_COUNT days after today.
const DAY_COUNT = 4;

const members = await db.query.householdMembers.findMany({ where: (m, { eq }) => eq(m.familyId, familyId), orderBy: (m, { asc }) => asc(m.sortOrder) });
const writableCalendars = await listWritableFamilyCalendars(familyId);

const now = new Date();
const rangeEnd = new Date(now);
rangeEnd.setDate(rangeEnd.getDate() + DAY_COUNT + 1);

const events = await fetchUpcomingEvents(familyId, now, rangeEnd);

// "Today" for the household, not the server (the Worker runs in UTC
// regardless of where the household actually is) — see lib/dates.ts.
const settings = await getDashboardSettings(familyId);
const timezone = settings.timezone === 'auto' ? householdTimezone() : settings.timezone;
const defaultCalendarId = writableCalendars.some((cal) => cal.id === settings.defaultEventCalendarId) ? settings.defaultEventCalendarId : 'local';
const today = zonedCalendarDate(now, timezone);
const days = Array.from({ length: DAY_COUNT }, (_, i) => {
  const d = new Date(today);
  d.setUTCDate(d.getUTCDate() + i + 1);
  return d;
});

// `days` entries are calendar-only dates normalized to UTC midnight (see
// zonedCalendarDate), so dateKeyUTC/toISOString on them is exact — no
// server-timezone shift.
const dateKey = dateKeyUTC;

function hasTimezone(value: string) {
  return /(?:Z|[+-]\d{2}:?\d{2})$/.test(value);
}

function timeLabel(event: CalendarEvent, timezone: string) {
  if (event.allDay) return 'All day';
  // Local events are stored as household wall-clock values from datetime-local;
  // Google events carry an offset/Z and should be converted into the household zone.
  if (!hasTimezone(event.start)) {
    const [hour, minute] = event.start.slice(11, 16).split(':').map(Number);
    const suffix = hour >= 12 ? 'PM' : 'AM';
    return `${hour % 12 || 12}:${String(minute).padStart(2, '0')} ${suffix}`;
  }
  return new Date(event.start).toLocaleTimeString([], {
    timeZone: timezone,
    hour: 'numeric',
    minute: '2-digit',
  });
}

const eventsByDay = events.reduce<Record<string, CalendarEvent[]>>((acc, event) => {
  const key = event.allDay || !hasTimezone(event.start)
    ? event.start.slice(0, 10)
    : zonedDateKey(new Date(event.start), timezone);
  acc[key] ??= [];
  acc[key].push(event);
  return acc;
}, {});

const todayKey = dateKey(today);
const todayEvents = [...(eventsByDay[todayKey] ?? [])].sort((a, b) => a.start.localeCompare(b.start));
---

<div class="rounded-3xl bg-surface p-5 shadow-card sm:p-6">
  <h2 class="mb-3 flex items-center gap-2 text-lg font-semibold">
    <span aria-hidden="true">📅</span> Calendar
    {canCreate && <button type="button" class="ml-auto rounded-full px-3 py-1.5 text-sm font-medium text-fg-muted hover:bg-surface-2 hover:text-fg" data-open-dialog="calendar-dialog">＋ Add</button>}
  </h2>

  <div class="calendar-today-row">
    <div class="calendar-today-label">
      <span class="calendar-today-badge">{today.getUTCDate()}</span>
      <div>
        <p class="calendar-today-kicker">Today</p>
        <p class="calendar-today-name">{today.toLocaleDateString([], { weekday: 'long', timeZone: 'UTC' })}</p>
      </div>
    </div>
    <div class="calendar-today-events">
      {todayEvents.length === 0 ? (
        <p class="text-sm text-fg-subtle">No events today</p>
      ) : (
        todayEvents.map((event) => (
          <div class="calendar-today-chip" style={`background-color:${event.color}22; border-color:${event.color}`}>
            {event.calendarId === 'local' && canDelete && (
              <form method="POST" action={`/api/admin/events/${event.id}/delete`} class="calendar-event-delete-form">
                <button type="submit" class="calendar-event-delete" aria-label={`Delete ${event.title}`}>×</button>
              </form>
            )}
            <p class="truncate pr-4 font-medium" title={event.description}>{event.title}</p>
            {event.memberName && <span class="truncate font-semibold" style={`color:${event.color}`}>{event.memberName}</span>}
            <span class="truncate text-fg-muted">{timeLabel(event, timezone)}</span>
            {event.location && <span class="truncate text-fg-subtle">{event.location}</span>}
          </div>
        ))
      )}
    </div>
  </div>

  <div class="grid grid-cols-4 gap-2 sm:gap-3">
        {days.map((day) => {
          const key = dateKey(day);
          const dayEvents = [...(eventsByDay[key] ?? [])].sort((a, b) =>
            a.start.localeCompare(b.start),
          );
          return (
            <div class="calendar-day min-w-0 rounded-2xl p-2 sm:p-3">
              <div class="mb-2 text-center">
                <div class="text-[11px] font-semibold uppercase tracking-wide text-fg-subtle">
                  {day.toLocaleDateString([], { weekday: 'short', timeZone: 'UTC' })}
                </div>
                <div class="mx-auto mt-1 flex h-7 w-7 items-center justify-center rounded-full text-sm font-bold text-fg">
                  {day.getUTCDate()}
                </div>
              </div>
              <div class="space-y-1.5">
                {dayEvents.length === 0 ? (
                  <p class="text-center text-xs text-fg-subtle">No events</p>
                ) : (
                  dayEvents.map((event) => (
                    <div
                      class="relative min-w-0 rounded-lg border-l-4 px-2 py-1.5 text-xs leading-tight"
                      style={`background-color:${event.color}22; border-color:${event.color}`}
                    >
                      {event.calendarId === 'local' && canDelete && (
                        <form method="POST" action={`/api/admin/events/${event.id}/delete`} class="calendar-event-delete-form">
                          <button type="submit" class="calendar-event-delete" aria-label={`Delete ${event.title}`}>×</button>
                        </form>
                      )}
                      <p class="truncate pr-4 font-medium" title={event.description}>{event.title}</p>
                      {event.memberName && <p class="truncate text-[10px] font-semibold" style={`color:${event.color}`}>{event.memberName}</p>}
                      <p class="truncate text-[11px] font-medium text-fg-muted">{timeLabel(event, timezone)}</p>
                      {event.location && <p class="truncate text-[10px] text-fg-subtle">{event.location}</p>}
                    </div>
                  ))
                )}
              </div>
            </div>
          );
        })}
  </div>
</div>

<dialog id="calendar-dialog" class="fixed inset-0 m-auto w-[min(92vw,34rem)] rounded-3xl bg-surface p-0 text-fg shadow-2xl backdrop:bg-black/60">
  <div class="flex items-center justify-between px-6 pt-5"><h3 class="text-xl font-semibold">Add event</h3><button type="button" class="text-2xl text-fg-muted" data-close-dialog aria-label="Close">×</button></div>
  <CalendarEventForm members={members} writableCalendars={writableCalendars} defaultCalendarId={defaultCalendarId} timezone={timezone} returnTo="/" compact fixedDefault />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#calendar-dialog');
  document.querySelector('[data-open-dialog="calendar-dialog"]')?.addEventListener('click', () => {
    const start = dialog?.querySelector<HTMLInputElement>('[name="start"]');
    const end = dialog?.querySelector<HTMLInputElement>('[name="end"]');
    if (start && !start.value) {
      const now = new Date();
      now.setMinutes(Math.ceil(now.getMinutes() / 15) * 15, 0, 0);
      const later = new Date(now.getTime() + 60 * 60 * 1000);
      const pad = (part: number) => String(part).padStart(2, '0');
      const value = (date: Date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
      start.value = value(now);
      if (end) end.value = value(later);
    }
    dialog?.showModal();
  });
  dialog?.querySelector('[data-close-dialog]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
</script>

<style>
  .calendar-day { background: var(--color-surface-2); box-shadow: inset -1px 0 0 var(--color-line-subtle); }
  .calendar-day:nth-child(even) { background: var(--color-surface); }
  .calendar-day [style*="background-color"] { color: var(--color-fg); }

  .calendar-today-row { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--color-line-subtle); }
  .calendar-today-label { display: flex; flex-shrink: 0; align-items: center; gap: 8px; min-width: 110px; }
  .calendar-today-badge { display: grid; width: 32px; height: 32px; flex-shrink: 0; place-items: center; border-radius: 50%; background: var(--color-accent); color: #fff; font-weight: 700; }
  .calendar-today-kicker { font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-fg-subtle); }
  .calendar-today-name { font-weight: 600; }
  .calendar-today-events { display: flex; flex: 1; flex-wrap: wrap; gap: 8px; align-content: flex-start; }
  .calendar-today-chip { position: relative; display: flex; min-width: 130px; max-width: 220px; flex-wrap: wrap; column-gap: 6px; border-left: 4px solid; border-radius: .6rem; padding: 5px 10px; font-size: 12px; line-height: 1.35; }
  .calendar-today-chip p { flex-basis: 100%; }

  .calendar-event-delete-form { position: absolute; top: 2px; right: 2px; }
  .calendar-event-delete { display: grid; width: 16px; height: 16px; place-items: center; border-radius: 50%; background: rgba(0,0,0,.12); color: var(--color-fg-muted); font-size: 12px; line-height: 1; cursor: pointer; }
  .calendar-event-delete:hover { background: var(--color-danger); color: #fff; }
</style>
