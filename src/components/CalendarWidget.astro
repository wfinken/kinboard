---
import { fetchUpcomingEvents, type CalendarEvent } from '../lib/google-calendar';
import { householdTimezone, zonedCalendarDate, dateKeyUTC } from '../lib/dates';

const DAY_COUNT = 4;

const ownerId = Astro.locals.session?.user?.id ?? null;

const now = new Date();
const rangeEnd = new Date(now);
rangeEnd.setDate(rangeEnd.getDate() + DAY_COUNT);

const events = ownerId ? await fetchUpcomingEvents(ownerId, now, rangeEnd) : [];

// "Today" for the household, not the server (the Worker runs in UTC
// regardless of where the household actually is) — see lib/dates.ts.
const today = zonedCalendarDate(now, householdTimezone());
const days = Array.from({ length: DAY_COUNT }, (_, i) => {
  const d = new Date(today);
  d.setUTCDate(d.getUTCDate() + i);
  return d;
});

// `days` entries are calendar-only dates normalized to UTC midnight (see
// zonedCalendarDate), so dateKeyUTC/toISOString on them is exact — no
// server-timezone shift.
const dateKey = dateKeyUTC;

function timeLabel(event: CalendarEvent) {
  if (event.allDay) return 'All day';
  return new Date(event.start).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
}

const eventsByDay = events.reduce<Record<string, CalendarEvent[]>>((acc, event) => {
  const key = event.start.slice(0, 10);
  acc[key] ??= [];
  acc[key].push(event);
  return acc;
}, {});

const todayKey = dateKey(today);
---

<div class="rounded-3xl bg-surface p-5 shadow-card sm:p-6">
  <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold">
    <span aria-hidden="true">📅</span> Calendar
  </h2>
  {
    !ownerId ? (
      <p class="text-fg-subtle">Connect a Google account in Admin → Calendars to see events.</p>
    ) : (
      <div class="grid grid-cols-4 gap-2 sm:gap-3">
        {days.map((day) => {
          const key = dateKey(day);
          const isToday = key === todayKey;
          const dayEvents = [...(eventsByDay[key] ?? [])].sort((a, b) =>
            a.start.localeCompare(b.start),
          );
          return (
            <div class="min-w-0 rounded-2xl bg-surface-2/60 p-2 sm:p-3">
              <div class="mb-2 text-center">
                <div class="text-[11px] font-semibold uppercase tracking-wide text-fg-subtle">
                  {day.toLocaleDateString([], { weekday: 'short', timeZone: 'UTC' })}
                </div>
                <div
                  class={`mx-auto mt-1 flex h-7 w-7 items-center justify-center rounded-full text-sm font-bold ${isToday ? 'bg-accent text-white' : 'text-fg'}`}
                >
                  {day.getUTCDate()}
                </div>
              </div>
              <div class="space-y-1.5">
                {dayEvents.length === 0 ? (
                  <p class="text-center text-xs text-fg-subtle">No events</p>
                ) : (
                  dayEvents.map((event) => (
                    <div
                      class="min-w-0 rounded-lg border-l-4 px-2 py-1.5 text-xs leading-tight"
                      style={`background-color:${event.color}22; border-color:${event.color}`}
                    >
                      <p class="truncate font-medium">{event.title}</p>
                      {event.memberName && <p class="truncate text-[10px] font-semibold" style={`color:${event.color}`}>{event.memberName}</p>}
                      <p class="truncate text-fg-subtle">{timeLabel(event)}</p>
                    </div>
                  ))
                )}
              </div>
            </div>
          );
        })}
      </div>
    )
  }
</div>
