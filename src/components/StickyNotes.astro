---
import { db } from '../db/client';
import { desc } from 'drizzle-orm';
import { stickyNotes } from '../db/schema';

const notes = await db.query.stickyNotes.findMany({
  orderBy: desc(stickyNotes.createdAt),
  limit: 6,
});
---

<div class="rounded-3xl bg-surface p-5 shadow-card sm:p-6">
  <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold">
    <span aria-hidden="true">📌</span> Bulletin Board
    <button type="button" class="ml-auto rounded-full px-3 py-1.5 text-sm font-medium text-fg-muted hover:bg-surface-2 hover:text-fg" data-open-dialog="note-dialog">＋ Add</button>
  </h2>
  {
    notes.length === 0 ? (
      <p class="text-fg-subtle">No notes yet.</p>
    ) : (
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {notes.map((note) => (
          <div
            class="min-h-24 rounded-2xl p-3 text-ink shadow"
            style={`background-color:${note.color}`}
          >
            <p class="text-sm font-medium leading-snug">{note.content}</p>
            {note.authorName && <p class="mt-2 text-xs text-ink-soft">— {note.authorName}</p>}
          </div>
        ))}
      </div>
    )
  }
</div>

<dialog id="note-dialog" class="fixed inset-0 m-auto w-[min(92vw,27rem)] rounded-3xl bg-surface p-0 text-fg shadow-2xl backdrop:bg-black/60"><form method="POST" action="/api/admin/notes" class="space-y-4 p-6"><input type="hidden" name="returnTo" value="/" /><div class="flex items-center justify-between"><h3 class="text-xl font-semibold">Post a note</h3><button type="button" class="text-2xl text-fg-muted" data-close-dialog>×</button></div><textarea name="content" required rows="3" autofocus placeholder="Write a message for the household…" class="w-full resize-none rounded-xl border border-line bg-surface-2 px-3 py-3"></textarea><input name="authorName" placeholder="From (optional)" class="w-full rounded-xl border border-line bg-surface-2 px-3 py-2.5" /><input type="hidden" name="color" value="#facc15" /><button class="w-full rounded-xl bg-accent px-4 py-3 font-semibold text-white hover:bg-accent-hover">Post note</button></form></dialog>

<script>
  const noteDialog = document.querySelector<HTMLDialogElement>('#note-dialog');
  document.querySelector('[data-open-dialog="note-dialog"]')?.addEventListener('click', () => noteDialog?.showModal());
  noteDialog?.querySelector('[data-close-dialog]')?.addEventListener('click', () => noteDialog.close());
  noteDialog?.addEventListener('click', (event) => { if (event.target === noteDialog) noteDialog.close(); });
</script>
