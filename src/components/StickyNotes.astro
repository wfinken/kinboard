---
import { db } from '../db/client';
import { desc } from 'drizzle-orm';
import { stickyNotes } from '../db/schema';

const notes = await db.query.stickyNotes.findMany({
  orderBy: desc(stickyNotes.createdAt),
  limit: 6,
});
---

<div class="rounded-3xl bg-surface p-5 shadow-card sm:p-6">
  <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold">
    <span aria-hidden="true">📌</span> Bulletin Board
  </h2>
  {
    notes.length === 0 ? (
      <p class="text-fg-subtle">No notes yet.</p>
    ) : (
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {notes.map((note) => (
          <div
            class="min-h-24 rounded-2xl p-3 text-ink shadow"
            style={`background-color:${note.color}`}
          >
            <p class="text-sm font-medium leading-snug">{note.content}</p>
            {note.authorName && <p class="mt-2 text-xs text-ink-soft">— {note.authorName}</p>}
          </div>
        ))}
      </div>
    )
  }
</div>
