<div
  class="flex items-center justify-center rounded-3xl bg-surface p-5 text-center shadow-card sm:p-6"
  data-clock
>
  <div>
    <div class="text-7xl font-bold tabular-nums tracking-tight" data-clock-time>--:--</div>
    <div class="mt-2 text-xl text-fg-muted" data-clock-date>Loading…</div>
  </div>
</div>

<script>
  const timeEl = document.querySelector<HTMLElement>('[data-clock-time]');
  const dateEl = document.querySelector<HTMLElement>('[data-clock-date]');

  function tick() {
    const now = new Date();
    if (timeEl) {
      timeEl.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }
    if (dateEl) {
      dateEl.textContent = now.toLocaleDateString([], {
        weekday: 'long',
        month: 'long',
        day: 'numeric',
      });
    }
  }

  tick();
  setInterval(tick, 1000);
</script>
