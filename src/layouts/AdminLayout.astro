---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getDashboardSettings } from '../lib/settings';

interface Props {
  title: string;
}

const { title } = Astro.props;
const session = Astro.locals.session;
const { theme } = await getDashboardSettings();

const navItems = [
  { href: '/admin', label: 'Overview' },
  { href: '/admin/calendars', label: 'Calendars' },
  { href: '/admin/chores', label: 'Chores' },
  { href: '/admin/meals', label: 'Meals' },
  { href: '/admin/notes', label: 'Notes' },
  { href: '/admin/layout', label: 'Layout' },
];
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeInit serverTheme={theme} />
    <title>{title} · KinBoard Admin</title>
  </head>
  <body class="min-h-screen bg-page text-fg font-sans">
    <div class="mx-auto max-w-4xl px-4 pb-16">
      <header class="border-b border-line-subtle py-4">
        <div class="flex items-center justify-between gap-3">
          <a href="/admin" class="shrink-0 text-lg font-semibold">
            KinBoard Admin
          </a>
          <div class="flex shrink-0 items-center gap-3">
            {session?.user && (
              <span class="hidden max-w-40 truncate text-sm text-fg-muted sm:inline">
                {session.user.email}
              </span>
            )}
            <ThemeToggle />
            <a
              href="/api/auth/signout"
              class="rounded-md bg-surface-2 px-3 py-2 text-sm hover:bg-surface-3"
            >
              Sign out
            </a>
          </div>
        </div>
        <nav class="-mx-4 mt-4 flex gap-1 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="shrink-0 rounded-md px-3 py-2.5 text-sm text-fg-muted hover:bg-surface-2 hover:text-fg"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>
      <main class="py-8">
        <h1 class="mb-6 text-2xl font-bold">{title}</h1>
        <slot />
      </main>
    </div>
  </body>
</html>
