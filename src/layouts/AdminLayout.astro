---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getDashboardSettings } from '../lib/settings';
import { getPermissions, isOwner } from '../lib/permissions';
import type { PermissionFeature } from '../db/schema';

interface Props { title: string; }

const { title } = Astro.props;
const session = Astro.locals.session;
const { theme } = await getDashboardSettings(Astro.locals.familyId);

const familyId = Astro.locals.familyId;
const userId = session?.user?.id;
const [permissions, owner] = familyId && userId
  ? await Promise.all([getPermissions(familyId, userId), isOwner(familyId, userId)])
  : [null, false];
const canRead = (feature?: PermissionFeature) => !feature || !permissions || permissions[feature].read;

const navItems = [
  { href: '/admin', label: 'Overview', icon: '⌂' },
  { href: '/admin/calendars', label: 'Calendars', icon: '▦', feature: 'calendars' as PermissionFeature },
  { href: '/admin/meals', label: 'Meals', icon: '◷', feature: 'meals' as PermissionFeature },
  { href: '/admin/notes', label: 'Notes', icon: '▤', feature: 'notes' as PermissionFeature },
  { href: '/admin/layout', label: 'Display', icon: '▣' },
  { href: '/admin/chores', label: 'Chores', icon: '✓', feature: 'chores' as PermissionFeature },
  { href: '/admin/allowance', label: 'Allowance', icon: '$', feature: 'allowance' as PermissionFeature },
  { href: '/admin/family', label: 'Family', icon: '♧', feature: 'family' as PermissionFeature },
  ...(owner ? [{ href: '/admin/permissions', label: 'Permissions', icon: '⚿' }] : []),
  { href: '/admin/account', label: 'Account', icon: '◎' },
].filter((item) => canRead('feature' in item ? item.feature : undefined));
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700&display=swap" rel="stylesheet" />
    <ThemeInit serverTheme={theme} />
    <title>{title} · KinBoard Admin</title>
  </head>
  <body class="min-h-screen bg-page text-fg font-sans admin-body">
    <div class="admin-shell">
      <aside class="admin-sidebar" id="admin-sidebar" aria-label="Admin navigation">
        <a href="/admin" class="admin-brand"><span class="admin-brand-mark">K.</span><span><strong>KinBoard</strong><small>FAMILY ADMIN</small></span></a>
        <a href="/" class="admin-family-display-button"><span aria-hidden="true">↗</span> Open family display</a>
        <p class="admin-nav-label">HOUSEHOLD</p>
        <nav aria-label="Admin settings" class="admin-nav">
          {navItems.map((item) => {
            const active = item.href === '/admin' ? currentPath === item.href : currentPath.startsWith(item.href);
            return <a href={item.href} class:list={['admin-nav-link', { active }]} aria-current={active ? 'page' : undefined}><span class="admin-nav-icon" aria-hidden="true">{item.icon}</span>{item.label}</a>;
          })}
        </nav>
        <div class="admin-sidebar-bottom">
          {session?.user && <p class="admin-user-email" title={session.user.email ?? ''}>{session.user.email}</p>}
          <a href="/api/auth/signout" class="admin-signout">Sign out <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
      <button class="admin-backdrop" type="button" aria-label="Close navigation" data-admin-close></button>
      <div class="admin-main-wrap">
        <header class="admin-topbar">
          <button class="admin-menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="admin-sidebar" data-admin-menu><span></span><span></span><span></span></button>
          <div class="admin-breadcrumb"><span>FAMILY ADMIN</span><span aria-hidden="true">·</span><strong>{title}</strong></div>
          <div class="admin-top-actions"><span class="admin-avatar" aria-hidden="true">{(session?.user?.name || session?.user?.email || 'K').slice(0, 1).toUpperCase()}</span><ThemeToggle /><a href="/api/auth/signout" class="admin-signout">Sign out</a></div>
        </header>
        <main class="admin-main">
          <div class="admin-page-heading"><div><p class="admin-eyebrow">KINBOARD <span aria-hidden="true">/</span> HOUSEHOLD</p><h1>{title}</h1></div><a href="/" class="admin-dashboard-link"><span>Open dashboard</span><b aria-hidden="true">↗</b></a></div>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('[data-admin-menu]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-admin-close]');
  const setMenu = (isOpen: boolean) => {
    document.documentElement.classList.toggle('admin-menu-open', isOpen);
    menuButton?.setAttribute('aria-expanded', String(isOpen));
  };
  menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
  closeButton?.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });
  document.querySelectorAll('.admin-nav-link').forEach((link) => link.addEventListener('click', () => setMenu(false)));
</script>
