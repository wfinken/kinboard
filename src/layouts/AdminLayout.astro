---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const session = Astro.locals.session;

const navItems = [
  { href: '/admin', label: 'Overview' },
  { href: '/admin/calendars', label: 'Calendars' },
  { href: '/admin/chores', label: 'Chores' },
  { href: '/admin/meals', label: 'Meals' },
  { href: '/admin/notes', label: 'Notes' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · KinBoard Admin</title>
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-100 font-sans">
    <div class="mx-auto max-w-4xl px-4 pb-16">
      <header class="flex items-center justify-between py-6 border-b border-neutral-800">
        <a href="/admin" class="text-lg font-semibold">KinBoard Admin</a>
        <nav class="flex items-center gap-1">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="rounded-md px-3 py-2 text-sm text-neutral-300 hover:bg-neutral-800 hover:text-white"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="flex items-center gap-3">
          {session?.user && <span class="text-sm text-neutral-400">{session.user.email}</span>}
          <a
            href="/api/auth/signout"
            class="rounded-md bg-neutral-800 px-3 py-1.5 text-sm hover:bg-neutral-700"
          >
            Sign out
          </a>
        </div>
      </header>
      <main class="py-8">
        <h1 class="mb-6 text-2xl font-bold">{title}</h1>
        <slot />
      </main>
    </div>
  </body>
</html>
