---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getDashboardSettings } from '../lib/settings';

interface Props {
  title: string;
}

const { title } = Astro.props;
const session = Astro.locals.session;
const { theme } = await getDashboardSettings();

const navItems = [
  { href: '/admin', label: 'Overview', icon: '🏠' },
  { href: '/admin/calendars', label: 'Calendars', icon: '📅' },
  { href: '/admin/chores', label: 'Chores', icon: '✅' },
  { href: '/admin/meals', label: 'Meals', icon: '🍽️' },
  { href: '/admin/notes', label: 'Notes', icon: '📌' },
  { href: '/admin/layout', label: 'Display', icon: '🎛️' },
  { href: '/admin/account', label: 'Account', icon: '👤' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeInit serverTheme={theme} />
    <title>{title} · KinBoard Admin</title>
  </head>
  <body class="min-h-screen bg-page text-fg font-sans">
    <div class="mx-auto max-w-4xl px-4 pb-16 sm:px-6">
      <header class="pt-5">
        <div class="flex items-center justify-between gap-3">
          <a href="/admin" class="shrink-0 text-lg font-semibold">
            KinBoard Admin
          </a>
          <div class="flex shrink-0 items-center gap-3">
            {session?.user && <a href="/admin/account" class="hidden max-w-40 truncate text-sm text-fg-muted hover:text-fg sm:inline">{session.user.email}</a>}
            <a
              href="/"
              class="rounded-full bg-surface-2 px-3 py-2 text-sm font-medium hover:bg-surface-3"
            >
              View Dashboard
            </a>
            <ThemeToggle />
            <a
              href="/api/auth/signout"
              class="rounded-full bg-surface-2 px-3 py-2 text-sm font-medium hover:bg-surface-3"
            >
              Sign out
            </a>
          </div>
        </div>
        <nav class="-mx-4 mt-5 flex gap-1 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0">
          {
            navItems.map((item) => {
              const active = currentPath === item.href;
              return (
                <a
                  href={item.href}
                  class={`flex shrink-0 items-center gap-1.5 rounded-full px-3.5 py-2 text-sm font-medium transition-colors ${
                    active ? 'bg-accent text-white' : 'text-fg-muted hover:bg-surface-2 hover:text-fg'
                  }`}
                >
                  <span aria-hidden="true">{item.icon}</span>
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </header>
      <main class="py-7">
        <h1 class="mb-6 text-2xl font-bold">{title}</h1>
        <slot />
      </main>
    </div>
  </body>
</html>
