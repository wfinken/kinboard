---
import Layout from '../layouts/Layout.astro';
import ClockWidget from '../components/ClockWidget.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import CalendarWidget from '../components/CalendarWidget.astro';
import TaskList from '../components/TaskList.astro';
import MealPlanWidget from '../components/MealPlanWidget.astro';
import StickyNotes from '../components/StickyNotes.astro';
import AllowanceWidget from '../components/AllowanceWidget.astro';
import { getDashboardSettings } from '../lib/settings';
import type { DashboardWidgetId } from '../db/schema';

const familyId = Astro.locals.familyId;
if (!familyId) return Astro.redirect('/welcome');
Astro.response.headers.set('Cache-Control', 'private, no-store');
const settings = await getDashboardSettings(familyId);

const WIDGET_COMPONENTS: Record<DashboardWidgetId, (_props: Record<string, never>) => unknown> = {
  clock: ClockWidget,
  weather: WeatherWidget,
  calendar: CalendarWidget,
  meals: MealPlanWidget,
  chores: TaskList,
  allowance: AllowanceWidget,
  notes: StickyNotes,
};
const enabled = new Set(settings.widgetOrder);
const orderedWidgets = settings.widgetOrder.filter((id) => id !== 'clock' && id !== 'weather');
const primaryWidgets = orderedWidgets.filter((id) => id === 'calendar' || id === 'chores' || id === 'notes');
const secondaryWidgets = orderedWidgets.filter((id) => id === 'meals' || id === 'allowance');
---

<Layout title="Dashboard" refreshSeconds={settings.refreshSeconds} theme={settings.theme} showControls={false}>
  <main class="wall-dashboard">
    <header class="wall-header">
      <div class="wall-brand"><span class="wall-brand-mark" aria-hidden="true">⌂</span><div><p class="wall-eyebrow">YOUR FAMILY, IN SYNC</p><h1>KinBoard</h1></div></div>
      <div class="wall-date" data-wall-date></div>
      <div class="wall-actions dashboard-controls">
        <button type="button" data-kiosk-toggle aria-pressed="false" class="wall-icon-button" aria-label="Toggle full screen">⛶</button>
        <a href="/admin" class="wall-icon-button" aria-label="Open family settings">⚙</a>
        <button type="button" data-theme-toggle class="wall-icon-button" aria-label="Toggle light and dark theme"><span data-theme-toggle-icon>☀️</span></button>
      </div>
    </header>

    <section class="wall-hero-row" aria-label="Time and weather">
      {enabled.has('clock') && <div class="wall-clock-card"><div class="wall-card-kicker"><span class="wall-status-dot"></span> RIGHT NOW</div><ClockWidget /></div>}
      {enabled.has('weather') && <div class="wall-weather-card"><div class="wall-card-kicker">⛅ WEATHER NEAR HOME</div><WeatherWidget /></div>}
    </section>

    <div class="wall-content-grid">
      <section class="wall-primary-column" aria-label="Family activities">
        {primaryWidgets.map((id) => {
          const Widget = WIDGET_COMPONENTS[id];
          const fullWidth = id === 'calendar';
          return <div class:list={['wall-widget', { 'wall-widget-wide': fullWidth }]} data-widget={id}><Widget /></div>;
        })}
      </section>
      <aside class="wall-secondary-column" aria-label="Family extras">
        {secondaryWidgets.map((id) => {
          const Widget = WIDGET_COMPONENTS[id];
          return <div class="wall-widget" data-widget={id}><Widget /></div>;
        })}
      </aside>
    </div>

    {settings.widgetOrder.length === 0 && <p class="wall-empty">No widgets enabled. Configure this dashboard from <a href="/admin/layout">Display settings</a>.</p>}
    <footer class="wall-footer"><span>Made with <b>♥</b> for the people who make a house a home.</span><span>Family dashboard</span></footer>
  </main>
</Layout>

<script>
  const date = document.querySelector<HTMLElement>('[data-wall-date]');
  if (date) date.textContent = new Date().toLocaleDateString([], { weekday: 'long', month: 'long', day: 'numeric' });
</script>
