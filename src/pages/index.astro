---
import Layout from '../layouts/Layout.astro';
import ClockWidget from '../components/ClockWidget.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import CalendarWidget from '../components/CalendarWidget.astro';
import TaskList from '../components/TaskList.astro';
import MealPlanWidget from '../components/MealPlanWidget.astro';
import StickyNotes from '../components/StickyNotes.astro';
import { getDashboardSettings } from '../lib/settings';
import type { DashboardWidgetId } from '../db/schema';

const settings = await getDashboardSettings();

const WIDGET_COMPONENTS: Record<DashboardWidgetId, (_props: Record<string, never>) => unknown> = {
  clock: ClockWidget,
  weather: WeatherWidget,
  calendar: CalendarWidget,
  meals: MealPlanWidget,
  chores: TaskList,
  notes: StickyNotes,
};

// Calendar and chores read better as wide cards; everything else is happy
// at one column on large screens. Order is otherwise fully admin-configurable.
const WIDE_WIDGETS = new Set<DashboardWidgetId>(['calendar', 'chores']);
---

<Layout title="Dashboard" refreshSeconds={settings.refreshSeconds} theme={settings.theme}>
  <div class="mx-auto max-w-7xl px-6 py-8">
    <div class="grid gap-6 lg:grid-cols-3">
      {
        settings.widgetOrder.map((id) => {
          const Widget = WIDGET_COMPONENTS[id];
          const spanClass = WIDE_WIDGETS.has(id) ? 'lg:col-span-2' : 'lg:col-span-1';
          return (
            <div class={spanClass}>
              <Widget />
            </div>
          );
        })
      }
    </div>
    {
      settings.widgetOrder.length === 0 && (
        <p class="text-center text-fg-subtle">
          No widgets enabled. Configure this dashboard from /admin/layout.
        </p>
      )
    }
  </div>
</Layout>
