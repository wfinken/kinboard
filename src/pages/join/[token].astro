---
import Layout from '../../layouts/Layout.astro';
import { getDashboardSettings } from '../../lib/settings';
const { token } = Astro.params;
const session = Astro.locals.session;
if (!session?.user) return Astro.redirect(`/login?callbackUrl=${encodeURIComponent(`/welcome?invite=${token}`)}`);
if (!Astro.locals.familyId) return Astro.redirect(`/welcome?invite=${token}`);
const { theme } = await getDashboardSettings(Astro.locals.familyId);
---
<Layout title="Join family" theme={theme}>
  <main class="mx-auto max-w-lg px-5 py-16"><section class="rounded-3xl bg-surface p-8 shadow-card"><h1 class="text-3xl font-bold">Join a family</h1><p class="mt-3 text-fg-muted">Sign in with Google to join the family that invited you.</p><a href={`/welcome?invite=${encodeURIComponent(token ?? '')}`} class="mt-6 block w-full rounded-2xl bg-accent px-4 py-3 text-center font-semibold text-white">Continue</a></section></main>
</Layout>
