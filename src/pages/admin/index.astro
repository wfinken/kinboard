---
const familyId = Astro.locals.familyId!;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../db/client';
import { calendars, chores, stickyNotes, allowanceLedger, allowanceBids, meals, familyMemberships } from '../../db/schema';
import { and, eq, gte, lte } from 'drizzle-orm';
import { getDashboardSettings } from '../../lib/settings';
import { getPermissions, isOwner } from '../../lib/permissions';
import { householdTimezone, zonedCalendarDate, dateKeyUTC } from '../../lib/dates';

const userId = Astro.locals.session!.user!.id;
const [perms, owner, settings] = await Promise.all([
  getPermissions(familyId, userId),
  isOwner(familyId, userId),
  getDashboardSettings(familyId),
]);

const timezone = settings.timezone === 'auto' ? householdTimezone() : settings.timezone;
const today = zonedCalendarDate(new Date(), timezone);
const todayKey = dateKeyUTC(today);
const weekEnd = new Date(today);
weekEnd.setUTCDate(weekEnd.getUTCDate() + 6);
const weekEndKey = dateKeyUTC(weekEnd);

const [myCalendars, choreCount, noteCount, ledger, pendingBids, mealCount, people, members, totalCalendars] = await Promise.all([
  db.query.calendars.findMany({ where: and(eq(calendars.userId, userId), eq(calendars.familyId, familyId)) }),
  db.$count(chores, eq(chores.familyId, familyId)),
  db.$count(stickyNotes, eq(stickyNotes.familyId, familyId)),
  db.query.allowanceLedger.findMany({ where: eq(allowanceLedger.familyId, familyId) }),
  db.$count(allowanceBids, and(eq(allowanceBids.familyId, familyId), eq(allowanceBids.status, 'pending'))),
  db.$count(meals, and(eq(meals.familyId, familyId), gte(meals.date, todayKey), lte(meals.date, weekEndKey))),
  db.select({ userId: familyMemberships.userId }).from(familyMemberships).where(eq(familyMemberships.familyId, familyId)),
  db.query.householdMembers.findMany({ where: (m, { eq }) => eq(m.familyId, familyId) }),
  db.$count(calendars, eq(calendars.familyId, familyId)),
]);
const allowanceCents = ledger.reduce((sum, row) => sum + (row.kind === 'deposit' ? row.amountCents : -row.amountCents), 0);
const nonAuthMemberCount = members.filter((m) => !m.userId).length;
const familyHeadcount = people.length + nonAuthMemberCount;

interface Stat { icon: string; label: string; value: string | number }
const rawStats: Array<Stat | false> = [
  perms.calendars.read && { icon: '📅', label: 'Calendars enabled', value: myCalendars.filter((c) => c.enabled).length },
  perms.chores.read && { icon: '✅', label: choreCount === 1 ? 'Chore' : 'Chores', value: choreCount },
  perms.notes.read && { icon: '📌', label: noteCount === 1 ? 'Sticky note' : 'Sticky notes', value: noteCount },
  perms.allowance.read && { icon: '💰', label: 'Allowance pool', value: `$${(allowanceCents / 100).toFixed(2)}` },
  perms.family.read && { icon: '👪', label: familyHeadcount === 1 ? 'Family member' : 'Family members', value: familyHeadcount },
  perms.meals.read && { icon: '🍽️', label: 'Meals this week', value: mealCount },
  perms.allowance.read && { icon: '🧾', label: pendingBids === 1 ? 'Bid to review' : 'Bids to review', value: pendingBids },
];
const stats = rawStats.filter((stat): stat is Stat => Boolean(stat));

const attention = [
  perms.allowance.read && pendingBids > 0 && { text: `${pendingBids} allowance ${pendingBids === 1 ? 'bid needs' : 'bids need'} review`, href: '/admin/allowance' },
  perms.calendars.read && totalCalendars === 0 && { text: 'No calendars connected yet', href: '/admin/calendars' },
  perms.family.read && familyHeadcount <= 1 && { text: 'Add the rest of the family', href: '/admin/family' },
].filter((item): item is { text: string; href: string } => Boolean(item));

const quickLinks = [
  perms.calendars.read && { href: '/admin/calendars', icon: '📅', label: 'Calendars', description: 'Connect Google Calendar and add events' },
  perms.chores.read && { href: '/admin/chores', icon: '✅', label: 'Chores', description: 'Assign chores and rewards' },
  perms.meals.read && { href: '/admin/meals', icon: '🍽️', label: 'Meals', description: 'Plan the week’s meals' },
  perms.notes.read && { href: '/admin/notes', icon: '📌', label: 'Notes', description: 'Post to the family bulletin board' },
  perms.allowance.read && { href: '/admin/allowance', icon: '💰', label: 'Allowance', description: 'Fund the pool and review bids' },
  perms.family.read && { href: '/admin/family', icon: '👪', label: 'Family', description: 'Manage who’s in the household' },
  owner && { href: '/admin/permissions', icon: '⚿', label: 'Permissions', description: 'Set what each member can do' },
  { href: '/admin/layout', icon: '▣', label: 'Display', description: 'Widgets, theme, and refresh rate' },
  { href: '/admin/account', icon: '◎', label: 'Account', description: 'Your name and connected services' },
].filter((link): link is { href: string; icon: string; label: string; description: string } => Boolean(link));
---

<AdminLayout title="Overview">
  <div class="admin-stat-strip">
    {
      stats.map((stat) => (
        <div class="admin-stat">
          <div class="admin-stat-icon" aria-hidden="true">{stat.icon}</div>
          <div class="admin-stat-value">{stat.value}</div>
          <div class="admin-stat-label">{stat.label}</div>
        </div>
      ))
    }
  </div>

  {attention.length > 0 && (
    <section class="admin-attention">
      {attention.map((item) => (
        <a href={item.href} class="admin-attention-item">
          <span>{item.text}</span>
          <span aria-hidden="true">→</span>
        </a>
      ))}
    </section>
  )}

  <section class="admin-quick-settings">
    <h2 class="admin-section-title">Quick settings</h2>
    <div class="admin-quick-settings-row">
      <form method="POST" action="/api/admin/settings/theme" class="admin-quick-setting">
        <input type="hidden" name="returnTo" value="/admin" />
        <label class="admin-quick-setting-label">Household default theme</label>
        <div class="admin-quick-setting-controls">
          <label><input type="radio" name="theme" value="dark" checked={settings.theme === 'dark'} onchange="this.form.requestSubmit()" /> Dark</label>
          <label><input type="radio" name="theme" value="light" checked={settings.theme === 'light'} onchange="this.form.requestSubmit()" /> Light</label>
        </div>
      </form>
      <form method="POST" action="/api/admin/settings/timezone" class="admin-quick-setting">
        <input type="hidden" name="returnTo" value="/admin" />
        <label class="admin-quick-setting-label" for="quick-timezone">Time zone</label>
        <select id="quick-timezone" name="timezone" class="admin-quick-setting-select" onchange="this.form.requestSubmit()">
          <option value="auto" selected={settings.timezone === 'auto'}>Use this device</option>
          {['America/New_York', 'America/Chicago', 'America/Denver', 'America/Los_Angeles', 'Europe/London', 'Europe/Paris', 'Asia/Tokyo', 'Australia/Sydney'].map((tz) => (
            <option value={tz} selected={settings.timezone === tz}>{tz.replaceAll('_', ' ')}</option>
          ))}
        </select>
      </form>
      <a href="/admin/layout" class="admin-quick-setting admin-quick-setting-link">
        <span class="admin-quick-setting-label">Widgets & refresh</span>
        <span class="admin-quick-setting-hint">Open Display settings →</span>
      </a>
    </div>
  </section>

  <section>
    <h2 class="admin-section-title">Manage</h2>
    <div class="admin-quicklink-grid">
      {quickLinks.map((link) => (
        <a href={link.href} class="admin-quicklink">
          <span class="admin-quicklink-icon" aria-hidden="true">{link.icon}</span>
          <span>
            <span class="admin-quicklink-label">{link.label}</span>
            <span class="admin-quicklink-description">{link.description}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</AdminLayout>
