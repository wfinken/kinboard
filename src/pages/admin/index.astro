---
const familyId = Astro.locals.familyId!;
import AdminLayout from '../../layouts/AdminLayout.astro';
import ColorPicker from '../../components/ColorPicker.astro';
import { db } from '../../db/client';
import { calendars, chores, stickyNotes } from '../../db/schema';
import { and, eq } from 'drizzle-orm';

const userId = Astro.locals.session?.user?.id;

const [members, myCalendars, choreCount, noteCount] = await Promise.all([
  db.query.householdMembers.findMany({ where: (m, { eq }) => eq(m.familyId, familyId), orderBy: (m, { asc }) => asc(m.sortOrder) }),
  userId
    ? db.query.calendars.findMany({ where: and(eq(calendars.userId, userId), eq(calendars.familyId, familyId)) })
    : Promise.resolve([]),
  db.$count(chores, eq(chores.familyId, familyId)),
  db.$count(stickyNotes, eq(stickyNotes.familyId, familyId)),
]);

const stats = [
  { icon: '📅', label: 'Calendars enabled', value: myCalendars.filter((c) => c.enabled).length },
  { icon: '✅', label: choreCount === 1 ? 'Chore' : 'Chores', value: choreCount },
  { icon: '📌', label: noteCount === 1 ? 'Sticky note' : 'Sticky notes', value: noteCount },
];
---

<AdminLayout title="Overview">
  <div class="admin-stat-strip">
    {
      stats.map((stat) => (
        <div class="admin-stat">
          <div class="admin-stat-icon" aria-hidden="true">{stat.icon}</div>
          <div class="admin-stat-value">{stat.value}</div>
          <div class="admin-stat-label">{stat.label}</div>
        </div>
      ))
    }
  </div>

  <section class="admin-members-section">
    <div class="admin-section-heading"><div><p class="admin-eyebrow">PEOPLE & PERMISSIONS</p><h2 class="mb-1 text-2xl font-semibold">Household members</h2></div><span class="admin-section-index">01</span></div>
    <p class="mb-5 max-w-xl text-sm text-fg-subtle">
      Members are used to assign chores and to color-code calendars.
    </p>
      <ul class="admin-member-list mb-6">
      {
        members.map((member) => (
          <li class="admin-member-row flex items-center justify-between px-2 py-3">
            <span class="flex items-center gap-2.5">
              <span class="admin-member-mark" style={`--member-color:${member.color}`}>
                {member.name.slice(0, 1).toUpperCase()}
              </span>
              <span class="font-medium">{member.name}</span>
            </span>
            <form method="POST" action={`/api/admin/members/${member.id}/delete`}>
              <button class="text-sm text-fg-subtle hover:text-danger">Remove</button>
            </form>
          </li>
        ))
      }
      {members.length === 0 && <p class="text-sm text-fg-subtle">No household members yet.</p>}
    </ul>
      <form method="POST" action="/api/admin/members" class="admin-member-form flex flex-wrap items-end gap-3">
      <div>
        <label class="block text-sm text-fg-muted" for="name">
          Name
        </label>
        <input
          id="name"
          name="name"
          required
          class="rounded-lg border border-line bg-surface-2 px-3 py-2.5"
        />
      </div>
      <div>
        <span class="block text-sm text-fg-muted">Color</span>
        <ColorPicker name="color" value="#38bdf8" label="Choose member color" />
      </div>
      <button class="rounded-full bg-success px-5 py-2.5 font-medium text-white hover:bg-success-hover">
        Add Member
      </button>
    </form>
  </section>
</AdminLayout>
