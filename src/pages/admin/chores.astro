---
const familyId = Astro.locals.familyId!;
import AdminLayout from '../../layouts/AdminLayout.astro';
import ChoreForm from '../../components/ChoreForm.astro';
import { db } from '../../db/client';
import { getPermissions } from '../../lib/permissions';

const perms = await getPermissions(familyId, Astro.locals.session!.user!.id);
if (!perms.chores.read) return Astro.redirect('/admin');

const [allChores, members, goals, completions] = await Promise.all([
  db.query.chores.findMany({
    where: (c, { eq }) => eq(c.familyId, familyId),
    orderBy: (c, { asc }) => asc(c.sortOrder),
  }),
  db.query.householdMembers.findMany({ where: (m, { eq }) => eq(m.familyId, familyId), orderBy: (m, { asc }) => asc(m.sortOrder) }),
  db.query.xpGoals.findMany({ where: (g, { eq }) => eq(g.familyId, familyId), orderBy: (g, { asc }) => asc(g.createdAt) }),
  db.query.choreCompletions.findMany({ where: (c, { eq }) => eq(c.familyId, familyId) }),
]);

const memberById = new Map(members.map((m) => [m.id, m]));
const choreById = new Map(allChores.map((c) => [c.id, c]));
const xpByMember = new Map<string, number>();
let familyXp = 0;
for (const completion of completions) {
  const chore = choreById.get(completion.choreId);
  if (!chore || chore.rewardType !== 'xp') continue;
  familyXp += chore.rewardPoints;
  const memberId = completion.memberId ?? chore.memberId;
  if (memberId) xpByMember.set(memberId, (xpByMember.get(memberId) ?? 0) + chore.rewardPoints);
}
---

<AdminLayout title="Chores">
  {perms.chores.create && (
  <ChoreForm members={members} returnTo="/admin/chores" />
  )}

  <ul class="space-y-2">
    {
      allChores.map((chore) => {
        const member = chore.memberId ? memberById.get(chore.memberId) : undefined;
        return (
          <li class="flex items-center justify-between gap-3 rounded-2xl bg-surface p-4 shadow-card">
            <div class="flex min-w-0 items-center gap-3">
              {member ? (
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white"
                  style={`background-color:${member.color}`}
                >
                  {member.name.slice(0, 1).toUpperCase()}
                </span>
              ) : (
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-2 text-xs">
                  —
                </span>
              )}
              <div class="min-w-0">
                <div class="truncate font-medium">{chore.title}</div>
                <div class="text-sm text-fg-subtle">
                  {chore.category} · {chore.frequency} · {chore.rewardType === 'allowance' ? `$${(chore.rewardCents / 100).toFixed(2)} allowance` : `${chore.rewardPoints} XP`}{chore.allowanceEnabled ? ` · bids up to $${(chore.maxBidCents / 100).toFixed(2)}` : ''}
                </div>
              </div>
            </div>
            {perms.chores.delete && (
              <form method="POST" action={`/api/admin/chores/${chore.id}/delete`}>
                <button class="shrink-0 text-sm text-fg-subtle hover:text-danger">Remove</button>
              </form>
            )}
          </li>
        );
      })
    }
    {allChores.length === 0 && <p class="rounded-2xl bg-surface p-5 text-fg-subtle shadow-card">No chores yet.</p>}
  </ul>

  <section id="xp-goals" class="mt-8 rounded-2xl bg-surface p-5 shadow-card">
    <div class="mb-4"><h2 class="text-xl font-semibold">⭐ XP goals</h2><p class="mt-1 text-sm text-fg-muted">Set a reward to work toward. XP adds up when XP chores are completed.</p></div>
    {perms.chores.create && <form method="POST" action="/api/admin/xp-goals" class="mb-5 flex flex-wrap items-end gap-3">
      <label class="min-w-40 flex-1 text-sm text-fg-muted">Goal<input name="title" required maxlength="80" placeholder="Movie night" class="mt-1 block w-full rounded-lg border border-line bg-surface-2 px-3 py-2.5" /></label>
      <label class="text-sm text-fg-muted">Who<select name="memberId" class="mt-1 block w-full rounded-lg border border-line bg-surface-2 px-3 py-2.5"><option value="">Everyone</option>{members.map((m) => <option value={m.id}>{m.name}</option>)}</select></label>
      <label class="text-sm text-fg-muted">XP target<input name="targetPoints" type="number" min="1" max="1000000" required placeholder="100" class="mt-1 block w-28 rounded-lg border border-line bg-surface-2 px-3 py-2.5" /></label>
      <button class="rounded-full bg-success px-5 py-2.5 font-medium text-white">Add goal</button>
    </form>}
    {goals.length ? <ul class="space-y-3">{goals.map((goal) => {
      const current = goal.memberId ? (xpByMember.get(goal.memberId) ?? 0) : familyXp;
      const memberName = goal.memberId ? memberById.get(goal.memberId)?.name : null;
      const percent = Math.min(100, Math.floor((current / goal.targetPoints) * 100));
      return <li class="rounded-xl bg-surface-2/60 p-4"><div class="flex items-start justify-between gap-3"><div><strong>{goal.title}</strong><p class="text-sm text-fg-muted">{memberName ?? 'Everyone'} · {current} / {goal.targetPoints} XP</p></div>{perms.chores.delete && <form method="POST" action="/api/admin/xp-goals"><input type="hidden" name="intent" value="delete" /><input type="hidden" name="id" value={goal.id} /><button class="text-sm text-fg-subtle hover:text-danger">Remove</button></form>}</div><div class="mt-3 h-2 overflow-hidden rounded-full bg-surface-3"><div class="h-full rounded-full bg-accent" style={`width:${percent}%`}></div></div></li>;
    })}</ul> : <p class="rounded-xl bg-surface-2/60 p-4 text-sm text-fg-muted">No XP goals yet. Add a goal to give chores a shared reward to work toward.</p>}
  </section>
</AdminLayout>
