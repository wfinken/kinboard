---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../db/client';
import { calendars } from '../../db/schema';
import { eq } from 'drizzle-orm';

const userId = Astro.locals.session?.user?.id!;
const myCalendars = await db.query.calendars.findMany({ where: eq(calendars.userId, userId) });

const error = Astro.url.searchParams.get('error');
const synced = Astro.url.searchParams.get('synced');
---

<AdminLayout title="Calendars">
  {
    error && (
      <div class="mb-6 rounded-lg border border-red-500/40 bg-red-500/10 p-4 text-sm text-red-400">
        <p class="font-medium">Sync failed</p>
        <p class="mt-1 break-words">{error}</p>
      </div>
    )
  }
  {
    synced != null && !error && (
      <div class="mb-6 rounded-lg border border-emerald-500/40 bg-emerald-500/10 p-4 text-sm text-emerald-400">
        Synced — found {synced} calendar{synced === '1' ? '' : 's'} in your Google account.
      </div>
    )
  }

  <form method="POST" action="/api/admin/calendars/sync" class="mb-6">
    <button class="rounded-md bg-emerald-600 px-4 py-2 font-medium hover:bg-emerald-500">
      Sync from Google
    </button>
    <span class="ml-3 text-sm text-fg-subtle">
      Pulls in any calendars from your Google account not yet listed below.
    </span>
  </form>

  {
    myCalendars.length === 0 ? (
      <p class="text-fg-subtle">No calendars synced yet.</p>
    ) : (
      <ul class="space-y-3">
        {myCalendars.map((cal) => (
          <li class="rounded-lg bg-surface p-4">
            <form
              method="POST"
              action={`/api/admin/calendars/${cal.id}`}
              class="flex flex-wrap items-center gap-4"
            >
              <span class="min-w-0 flex-1 truncate font-medium">{cal.name}</span>
              <input type="color" name="color" value={cal.color} class="h-9 w-12 rounded border border-line bg-surface-2 p-1" />
              <label class="flex items-center gap-2 text-sm text-fg-muted">
                <input type="checkbox" name="enabled" checked={cal.enabled} class="h-4 w-4" />
                Show on dashboard
              </label>
              <button class="rounded-md bg-surface-3 px-3 py-1.5 text-sm hover:bg-surface-3-hover">
                Save
              </button>
            </form>
          </li>
        ))}
      </ul>
    )
  }
</AdminLayout>
