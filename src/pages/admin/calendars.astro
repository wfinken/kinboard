---
const familyId = Astro.locals.familyId!;
import AdminLayout from '../../layouts/AdminLayout.astro';
import ColorPicker from '../../components/ColorPicker.astro';
import CalendarEventForm from '../../components/CalendarEventForm.astro';
import { db } from '../../db/client';
import { calendars } from '../../db/schema';
import { and, eq } from 'drizzle-orm';
import { listWritableFamilyCalendars } from '../../lib/google-calendar';
import { getPermissions } from '../../lib/permissions';
import { getDashboardSettings } from '../../lib/settings';
import { householdTimezone } from '../../lib/dates';

const userId = Astro.locals.session?.user?.id!;
const perms = await getPermissions(familyId, userId);
if (!perms.calendars.read) return Astro.redirect('/admin');
const myCalendars = await db.query.calendars.findMany({ where: and(eq(calendars.userId, userId), eq(calendars.familyId, familyId)) });
const members = await db.query.householdMembers.findMany({ where: (m, { eq }) => eq(m.familyId, familyId), orderBy: (members, { asc }) => [asc(members.sortOrder)] });
const googleAccount = await db.query.accounts.findFirst({ where: (a, { and, eq }) => and(eq(a.userId, userId), eq(a.provider, 'google')) });
const hasEventWriteScope = googleAccount?.scope?.split(/\s+/).includes('https://www.googleapis.com/auth/calendar.events') ?? false;
const writableCalendars = await listWritableFamilyCalendars(familyId);
const settings = await getDashboardSettings(familyId);
const defaultCalendarId = writableCalendars.some((cal) => cal.id === settings.defaultEventCalendarId) ? settings.defaultEventCalendarId : 'local';
const timezone = settings.timezone === 'auto' ? householdTimezone() : settings.timezone;

const error = Astro.url.searchParams.get('error');
const eventError = Astro.url.searchParams.get('eventError');
const synced = Astro.url.searchParams.get('synced');
const savedDefault = Astro.url.searchParams.get('savedDefault');
---

<AdminLayout title="Calendars">
  {
    error && (
      <div class="mb-6 rounded-2xl border border-danger bg-danger-soft p-4 text-sm text-danger">
        <p class="font-medium">Sync failed</p>
        <p class="mt-1 break-words">{error}</p>
      </div>
    )
  }

  {perms.calendars.update && <section class="mb-6 rounded-2xl bg-surface p-5 shadow-card"><h2 class="mb-1 text-lg font-semibold">Default event destination</h2><p class="mb-4 text-sm text-fg-subtle">Choose where new events go by default. You can change the destination for an individual event when adding it.</p><form method="POST" action="/api/admin/settings/default-event-calendar" class="flex flex-wrap items-end gap-3"><label class="min-w-60 flex-1 text-sm font-medium">Calendar<select name="defaultEventCalendarId" class="mt-1 w-full rounded-lg border border-line bg-surface-2 px-3 py-2.5"><option value="local" selected={defaultCalendarId === 'local'}>KinBoard only</option>{writableCalendars.map((cal) => <option value={cal.id} selected={defaultCalendarId === cal.id}>Google Calendar: {cal.name}</option>)}</select></label><button class="rounded-full bg-success px-5 py-2.5 font-medium text-white hover:bg-success-hover">Save default</button>{savedDefault && <span class="text-sm text-success">Default saved</span>}</form></section>}

  {perms.calendars.create && (
    <section class="mb-8 rounded-2xl bg-surface p-5 shadow-card">
      <h2 class="mb-1 text-lg font-semibold">Add family event</h2>
      <p class="mb-4 text-sm text-fg-subtle">Events appear on the dashboard in the selected family member’s color.</p>
      {eventError && <p class="mb-4 text-sm text-danger">{eventError}</p>}
      {!hasEventWriteScope && <p class="mb-4 text-sm text-fg-muted">Connect Google event access to create events directly on a synced calendar. <a class="font-medium text-accent hover:underline" href={`/api/admin/calendars/connect?returnTo=${encodeURIComponent('/admin/calendars')}`}>Connect Google Calendar</a></p>}
      <CalendarEventForm members={members} writableCalendars={writableCalendars} defaultCalendarId={defaultCalendarId} timezone={timezone} returnTo="/admin/calendars" />
    </section>
  )}
  {
    synced != null && !error && (
      <div class="mb-6 rounded-2xl border border-success bg-success-soft p-4 text-sm text-success">
        Synced — found {synced} calendar{synced === '1' ? '' : 's'} in your Google account.
      </div>
    )
  }

  {perms.calendars.create && (
    <form method="POST" action="/api/admin/calendars/sync" class="mb-6 flex flex-wrap items-center gap-3">
      <button class="rounded-full bg-success px-5 py-2.5 font-medium text-white hover:bg-success-hover">
        Sync from Google
      </button>
      <span class="text-sm text-fg-subtle">
        Pulls in any calendars from your Google account not yet listed below.
      </span>
    </form>
  )}

  {
    myCalendars.length === 0 ? (
      <p class="rounded-2xl bg-surface p-5 text-fg-subtle shadow-card">No calendars synced yet.</p>
    ) : (
      <ul class="space-y-3">
        {myCalendars.map((cal) => (
          <li class="rounded-2xl bg-surface p-4 shadow-card">
            <form
              method="POST"
              action={`/api/admin/calendars/${cal.id}`}
              class="flex flex-wrap items-center gap-4"
            >
              <span
                class="h-3 w-3 shrink-0 rounded-full"
                style={`background-color:${cal.color}`}
              />
              <span class="min-w-0 flex-1 truncate font-medium">{cal.name}</span>
              {perms.calendars.update ? (
                <>
                  <ColorPicker name="color" value={cal.color} label={`Choose color for ${cal.name}`} />
                  <label class="flex items-center gap-2 text-sm text-fg-muted">
                    <input
                      type="checkbox"
                      name="enabled"
                      checked={cal.enabled}
                      class="h-4 w-4 accent-success"
                    />
                    Show on dashboard
                  </label>
                  <button
                    type="submit"
                    data-save-button
                    class="rounded-full px-4 py-1.5 text-sm font-medium text-fg-subtle transition-colors"
                  >
                    Save
                  </button>
                </>
              ) : (
                <span class="text-sm text-fg-subtle">{cal.enabled ? 'Shown on dashboard' : 'Hidden'}</span>
              )}
            </form>
          </li>
        ))}
      </ul>
    )
  }
</AdminLayout>

<style>
  /* Muted until the form actually has unsaved changes, so it's obvious
     whether a click will do anything. */
  [data-save-button] {
    background-color: var(--color-surface-3);
  }
  [data-save-button][data-dirty='true'] {
    background-color: var(--color-accent);
    color: white;
  }
  [data-save-button]:hover {
    background-color: var(--color-surface-3-hover);
  }
  [data-save-button][data-dirty='true']:hover {
    background-color: var(--color-accent-hover);
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form').forEach((form) => {
    const saveButton = form.querySelector<HTMLButtonElement>('[data-save-button]');
    if (!saveButton) return;
    saveButton.dataset.dirty = 'false';
    form.addEventListener('input', () => {
      saveButton.dataset.dirty = 'true';
    });
    form.addEventListener('change', () => {
      saveButton.dataset.dirty = 'true';
    });
  });
</script>
