---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDashboardSettings, WIDGET_LABELS } from '../../lib/settings';
import { DASHBOARD_WIDGETS } from '../../db/schema';

const settings = await getDashboardSettings();
const displayOrder = [
  ...settings.widgetOrder,
  ...DASHBOARD_WIDGETS.filter((id) => !settings.widgetOrder.includes(id)),
];
const enabledSet = new Set(settings.widgetOrder);
---

<AdminLayout title="Display">
  <section class="mb-6 rounded-2xl bg-surface p-5 shadow-card sm:p-6">
    <div class="mb-5">
      <p class="text-xs font-semibold uppercase tracking-wider text-accent">Dashboard</p>
      <h2 class="mt-1 text-xl font-semibold">Arrange your dashboard</h2>
      <p class="mt-1 text-sm text-fg-muted">Choose what appears, set tile sizes, and control the order people see on the wall display.</p>
    </div>
    <h3 class="mb-1 text-lg font-semibold">Widget order</h3>
    <p class="mb-4 text-sm text-fg-subtle">
      Enabled widgets appear on the dashboard top to bottom, left column first.
    </p>
    {
      settings.widgetOrder.length === 0 ? (
        <p class="text-fg-subtle">No widgets enabled — turn some on below.</p>
      ) : (
        <ul class="space-y-2">
          {settings.widgetOrder.map((id, i) => (
            <li class="flex items-center justify-between rounded-xl bg-surface-2/60 px-4 py-3">
              <span class="font-medium">{WIDGET_LABELS[id]}</span>
              <div class="flex gap-2">
                <form method="POST" action="/api/admin/settings/widgets/move">
                  <input type="hidden" name="widgetId" value={id} />
                  <input type="hidden" name="direction" value="up" />
                  <button
                    class="min-w-11 rounded-full bg-surface-3 px-3 py-2 hover:bg-surface-3-hover disabled:cursor-not-allowed disabled:bg-transparent disabled:text-fg-subtle disabled:opacity-40"
                    disabled={i === 0}
                  >
                    ↑
                  </button>
                </form>
                <form method="POST" action="/api/admin/settings/widgets/move">
                  <input type="hidden" name="widgetId" value={id} />
                  <input type="hidden" name="direction" value="down" />
                  <button
                    class="min-w-11 rounded-full bg-surface-3 px-3 py-2 hover:bg-surface-3-hover disabled:cursor-not-allowed disabled:bg-transparent disabled:text-fg-subtle disabled:opacity-40"
                    disabled={i === settings.widgetOrder.length - 1}
                  >
                    ↓
                  </button>
                </form>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <form method="POST" action="/api/admin/settings/widgets" class="space-y-6">
    <section class="rounded-2xl bg-surface p-5 shadow-card sm:p-6">
      <h2 class="text-lg font-semibold">Widgets and tile sizes</h2>
      <p class="mb-4 mt-1 text-sm text-fg-muted">Turn widgets on or off and choose how much space each one gets. New widgets join the end of the order above.</p>
      <ul class="space-y-2">
        {
          displayOrder.map((id) => (
            <li class="flex items-center gap-3 rounded-xl bg-surface-2/60 px-4 py-3">
              <input
                type="checkbox"
                name={`widget_${id}`}
                checked={enabledSet.has(id)}
                class="h-5 w-5 rounded border-line bg-surface accent-success"
              />
              <span>{WIDGET_LABELS[id]}</span>
              <label class="ml-auto flex items-center gap-2 text-sm text-fg-muted">Tile size
                <select name={`size_${id}`} class="rounded-lg border border-line bg-surface px-2 py-1.5">
                  <option value="1x1" selected={(settings.widgetSizes[id] ?? '1x1') === '1x1'}>1 × 1</option>
                  <option value="2x1" selected={settings.widgetSizes[id] === '2x1'}>2 × 1</option>
                  <option value="2x2" selected={settings.widgetSizes[id] === '2x2'}>2 × 2</option>
                </select>
              </label>
            </li>
          ))
        }
      </ul>
    </section>
    <section class="rounded-2xl bg-surface p-5 shadow-card sm:p-6">
      <h2 class="text-lg font-semibold">Display and refresh</h2>
      <p class="mb-4 mt-1 text-sm text-fg-muted">Set the dashboard’s time zone, default appearance, and how often it reloads.</p>
      <div class="flex flex-wrap gap-6">
        <div>
          <label class="block text-sm text-fg-muted" for="refreshSeconds">
            Dashboard refresh interval (seconds)
          </label>
          <input
            id="refreshSeconds"
            name="refreshSeconds"
            type="number"
            min="30"
            step="30"
            value={settings.refreshSeconds}
            class="w-32 rounded-lg border border-line bg-surface-2 px-3 py-2"
          />
        </div>
        <fieldset>
          <legend class="block text-sm text-fg-muted">Household default theme</legend>
          <div class="mt-1 flex gap-3">
            <label class="flex items-center gap-1.5 text-sm">
              <input type="radio" name="theme" value="dark" checked={settings.theme === 'dark'} />
              Dark
            </label>
            <label class="flex items-center gap-1.5 text-sm">
              <input type="radio" name="theme" value="light" checked={settings.theme === 'light'} />
              Light
            </label>
          </div>
          <p class="mt-1 text-xs text-fg-subtle">The toggle in the corner can override this on this device.</p>
        </fieldset>
      </div>
    </section>
    <div class="flex flex-wrap items-center gap-3">
      <button class="rounded-full bg-success px-6 py-3 font-semibold text-white hover:bg-success-hover">Save dashboard settings</button>
      <span class="text-sm text-fg-subtle">Changes apply to the household dashboard.</span>
    </div>
  </form>
</AdminLayout>
