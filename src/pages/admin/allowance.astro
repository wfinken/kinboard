---
const familyId = Astro.locals.familyId!;
import { desc } from 'drizzle-orm';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../db/client';
import { allowanceBids, allowanceLedger } from '../../db/schema';
import { getPermissions } from '../../lib/permissions';

const perms = await getPermissions(familyId, Astro.locals.session!.user!.id);
if (!perms.allowance.read) return Astro.redirect('/admin');

const [ledger, bids, allChores, members] = await Promise.all([
  db.query.allowanceLedger.findMany({ where: (l, { eq }) => eq(l.familyId, familyId), orderBy: desc(allowanceLedger.createdAt) }),
  db.query.allowanceBids.findMany({ where: (b, { eq }) => eq(b.familyId, familyId), orderBy: desc(allowanceBids.createdAt) }),
  db.query.chores.findMany({ where: (c, { eq }) => eq(c.familyId, familyId) }),
  db.query.householdMembers.findMany({ where: (m, { eq }) => eq(m.familyId, familyId), orderBy: (m, { asc }) => asc(m.sortOrder) }),
]);
const balanceCents = ledger.reduce((sum, row) => sum + (row.kind === 'deposit' ? row.amountCents : -row.amountCents), 0);
const reservedCents = bids.filter((bid) => bid.status === 'approved').reduce((sum, bid) => sum + bid.amountCents, 0);
const availableCents = balanceCents - reservedCents;
const choreById = new Map(allChores.map((chore) => [chore.id, chore]));
const memberById = new Map(members.map((member) => [member.id, member]));
const allowanceChores = allChores.filter((chore) => chore.allowanceEnabled);
const pendingBids = bids.filter((bid) => bid.status === 'pending');
const statusLabel: Record<string, string> = { pending: 'Awaiting approval', approved: 'Approved · awaiting completion', rejected: 'Declined', paid: 'Paid' };
---

<AdminLayout title="Allowance">
  <div class="mb-6 grid gap-4 sm:grid-cols-3">
    <article class="rounded-2xl bg-surface p-5 shadow-card"><p class="text-sm text-fg-muted">Allowance pool</p><p class="mt-2 text-3xl font-bold">${(balanceCents / 100).toFixed(2)}</p><p class="mt-1 text-xs text-fg-subtle">Total parent-funded balance</p></article>
    <article class="rounded-2xl bg-surface p-5 shadow-card"><p class="text-sm text-fg-muted">Available to approve</p><p class="mt-2 text-3xl font-bold">${(Math.max(0, availableCents) / 100).toFixed(2)}</p><p class="mt-1 text-xs text-fg-subtle">Excludes approved bids</p></article>
    <article class="rounded-2xl bg-surface p-5 shadow-card"><p class="text-sm text-fg-muted">Bids to review</p><p class="mt-2 text-3xl font-bold">{pendingBids.length}</p><p class="mt-1 text-xs text-fg-subtle">Approval assigns the chore to the bidder</p></article>
  </div>

  {perms.allowance.create && (
  <section class="mb-6 rounded-2xl bg-surface p-5 shadow-card sm:p-6">
    <h2 class="text-lg font-semibold">Add money to the pool</h2>
    <p class="mb-4 mt-1 text-sm text-fg-muted">Record money you’ve set aside for allowance. Approved bids reserve funds; completed chores are paid from the pool.</p>
    <form method="POST" action="/api/admin/allowance/fund" class="flex flex-wrap items-end gap-3">
      <label class="text-sm text-fg-muted">Amount ($)<input name="amount" type="number" min="0.01" max="10000" step="0.01" required class="mt-1 block w-36 rounded-lg border border-line bg-surface-2 px-3 py-2.5" /></label>
      <label class="min-w-48 flex-1 text-sm text-fg-muted">Note<input name="note" maxlength="160" placeholder="Weekly allowance budget" class="mt-1 block w-full rounded-lg border border-line bg-surface-2 px-3 py-2.5" /></label>
      <button class="rounded-full bg-success px-5 py-2.5 font-semibold text-white hover:bg-success-hover">Add funds</button>
    </form>
  </section>
  )}

  <section class="mb-6 rounded-2xl bg-surface p-5 shadow-card sm:p-6">
    <h2 class="mb-1 text-lg font-semibold">Review chore bids</h2>
    <p class="mb-4 text-sm text-fg-muted">Approve one bid per chore. The bid must be within the parent-set maximum and available pool balance.</p>
    {pendingBids.length ? <ul class="space-y-3">{pendingBids.map((bid) => {
      const chore = choreById.get(bid.choreId);
      const member = memberById.get(bid.memberId);
      return <li class="flex flex-wrap items-center gap-3 rounded-xl bg-surface-2/60 p-4">
        <div class="min-w-0 flex-1"><p class="font-semibold">{chore?.title ?? 'Removed chore'} · ${ (bid.amountCents / 100).toFixed(2) }</p><p class="text-sm text-fg-muted">Bid by {member?.name ?? 'Family member'} · max ${( (chore?.maxBidCents ?? 0) / 100).toFixed(2)}</p></div>
        {perms.allowance.update ? <form method="POST" action={`/api/admin/allowance/bids/${bid.id}`} class="flex gap-2"><button name="decision" value="approve" class="rounded-full bg-success px-4 py-2 text-sm font-semibold text-white hover:bg-success-hover">Approve</button><button name="decision" value="reject" class="rounded-full bg-surface-3 px-4 py-2 text-sm font-medium hover:bg-surface-3-hover">Decline</button></form> : <span class="text-sm text-fg-subtle">Awaiting review</span>}
      </li>;
    })}</ul> : <p class="rounded-xl bg-surface-2/60 p-4 text-sm text-fg-muted">No bids need review.</p>}
  </section>

  <section class="mb-6 rounded-2xl bg-surface p-5 shadow-card sm:p-6">
    <h2 class="mb-1 text-lg font-semibold">Allowance chores and bid limits</h2>
    <p class="mb-4 text-sm text-fg-muted">Set up or edit chores on the <a href="/admin/chores" class="text-accent hover:underline">Chores</a> page. Each chore has its own maximum bid.</p>
    {allowanceChores.length ? <ul class="space-y-2">{allowanceChores.map((chore) => <li class="flex justify-between gap-3 rounded-xl bg-surface-2/60 px-4 py-3"><span>{chore.title}</span><span class="font-semibold">Up to ${(chore.maxBidCents / 100).toFixed(2)}</span></li>)}</ul> : <p class="rounded-xl bg-surface-2/60 p-4 text-sm text-fg-muted">No chores are open for bids yet. Enable bidding and set a maximum on the Chores page.</p>}
  </section>

  <section class="rounded-2xl bg-surface p-5 shadow-card sm:p-6">
    <h2 class="mb-4 text-lg font-semibold">Recent allowance activity</h2>
    {bids.length ? <ul class="space-y-2">{bids.slice(0, 12).map((bid) => <li class="flex flex-wrap justify-between gap-2 rounded-xl bg-surface-2/60 px-4 py-3 text-sm"><span>{memberById.get(bid.memberId)?.name ?? 'Family member'} · {choreById.get(bid.choreId)?.title ?? 'Chore'} · ${(bid.amountCents / 100).toFixed(2)}</span><span class="text-fg-muted">{statusLabel[bid.status] ?? bid.status}</span></li>)}</ul> : <p class="text-sm text-fg-muted">Bids will show here as kids submit them.</p>}
    {ledger.length > 0 && <div class="mt-5 border-t border-line-subtle pt-4"><h3 class="mb-2 font-medium">Pool activity</h3><ul class="space-y-2">{ledger.slice(0, 8).map((entry) => <li class="flex justify-between gap-3 text-sm"><span class="text-fg-muted">{entry.note || 'Allowance pool'}{entry.kind === 'payout' && entry.memberId ? ` · earned by ${memberById.get(entry.memberId)?.name ?? 'Family member'}` : ''} · {entry.createdAt.toLocaleDateString()}</span><span class="font-medium">{entry.kind === 'deposit' ? '+' : '−'}${(entry.amountCents / 100).toFixed(2)}</span></li>)}</ul></div>}
  </section>
</AdminLayout>
