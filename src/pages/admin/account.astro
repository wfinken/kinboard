---
import { eq } from 'drizzle-orm';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../db/client';
import { accounts } from '../../db/schema';
import { getDashboardSettings } from '../../lib/settings';

const user = Astro.locals.session?.user;
const linkedAccounts = user?.id
  ? await db.query.accounts.findMany({ where: eq(accounts.userId, user.id) })
  : [];
const googleAccount = linkedAccounts.find((account) => account.provider === 'google');
const settings = await getDashboardSettings();
---

<AdminLayout title="Account">
  <div class="mb-6 rounded-2xl bg-surface p-5 shadow-card sm:p-6">
    <p class="text-xs font-semibold uppercase tracking-wider text-accent">Personal settings</p>
    <h2 class="mt-1 text-xl font-semibold">Your KinBoard account</h2>
    <p class="mt-1 text-sm text-fg-muted">View the sign-in identity and services connected to this account.</p>
  </div>

  <section class="mb-5 rounded-2xl bg-surface p-5 shadow-card sm:p-6">
    <h3 class="text-lg font-semibold">Sign-in profile</h3>
    <dl class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl bg-surface-2/60 p-4">
        <dt class="text-sm text-fg-muted">Name</dt>
        <dd class="mt-1 font-medium">{user?.name || 'Not provided'}</dd>
      </div>
      <div class="rounded-xl bg-surface-2/60 p-4">
        <dt class="text-sm text-fg-muted">Email</dt>
        <dd class="mt-1 break-all font-medium">{user?.email || 'Not available'}</dd>
      </div>
    </dl>
    <p class="mt-4 text-sm text-fg-subtle">KinBoard gets this profile from your sign-in provider. To change your name or email, update it with that provider.</p>
  </section>

  <section class="mb-5 rounded-2xl bg-surface p-5 shadow-card sm:p-6">
    <h3 class="text-lg font-semibold">Household time zone</h3>
    <p class="mb-4 mt-1 text-sm text-fg-muted">Calendar days and event times use this time zone across the household dashboard.</p>
    <form method="POST" action="/api/admin/settings/timezone" class="flex flex-wrap items-end gap-3">
      <label class="text-sm text-fg-muted" for="timezone">Time zone
        <select id="timezone" name="timezone" class="mt-1 block rounded-lg border border-line bg-surface-2 px-3 py-2.5">
          <option value="auto" selected={settings.timezone === 'auto'}>Use this device</option>
          {['America/New_York','America/Chicago','America/Denver','America/Los_Angeles','Europe/London','Europe/Paris','Asia/Tokyo','Australia/Sydney'].map((tz) => (
            <option value={tz} selected={settings.timezone === tz}>{tz.replaceAll('_', ' ')}</option>
          ))}
        </select>
      </label>
      <button class="rounded-full bg-success px-5 py-2.5 font-semibold text-white hover:bg-success-hover">Save time zone</button>
      <span class="text-xs text-fg-subtle">Current setting: {settings.timezone === 'auto' ? 'Use this device' : settings.timezone.replaceAll('_', ' ')}</span>
    </form>
  </section>

  <section class="mb-5 rounded-2xl bg-surface p-5 shadow-card sm:p-6">
    <h3 class="text-lg font-semibold">Connected services</h3>
    <div class="mt-4 flex flex-wrap items-center gap-4 rounded-xl bg-surface-2/60 p-4">
      <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-xl" aria-hidden="true">G</span>
      <div class="min-w-0 flex-1">
        <p class="font-medium">Google Calendar</p>
        <p class="text-sm text-fg-muted">{googleAccount ? 'Connected for calendar access' : 'Not connected'}</p>
      </div>
      {googleAccount && <span class="rounded-full bg-success-soft px-3 py-1 text-sm font-medium text-success">Connected</span>}
    </div>
    <p class="mt-3 text-sm text-fg-subtle">Calendar access is granted when you sign in with Google. Manage visible calendars and colors on the <a href="/admin/calendars" class="font-medium text-accent hover:underline">Calendars</a> page.</p>
  </section>

  <section class="rounded-2xl border border-line bg-surface p-5 shadow-card sm:p-6">
    <h3 class="text-lg font-semibold">Sign out</h3>
    <p class="mb-4 mt-1 text-sm text-fg-muted">End this session on the current device.</p>
    <a href="/api/auth/signout" class="inline-flex rounded-full bg-surface-3 px-5 py-2.5 font-medium hover:bg-surface-3-hover">Sign out of KinBoard</a>
  </section>
</AdminLayout>

<script>
  const timezone = document.getElementById('timezone') as HTMLSelectElement | null;
  if (timezone && timezone.value === 'auto') {
    try {
      const detected = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (detected) {
        const option = Array.from(timezone.options).find((item) => item.value === detected);
        if (option) timezone.value = detected;
        else timezone.add(new Option(`${detected.replaceAll('_', ' ')} (detected)`, detected, true, true));
      }
    } catch { /* Keep auto when browser detection is unavailable. */ }
  }
</script>
