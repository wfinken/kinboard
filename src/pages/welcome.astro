---
import Layout from '../layouts/Layout.astro';
import { getDashboardSettings } from '../lib/settings';
import { db } from '../db/client';
import { calendars } from '../db/schema';
import { and, eq } from 'drizzle-orm';

const user = Astro.locals.session?.user;
if (!user) return Astro.redirect('/login');
const { theme } = await getDashboardSettings(Astro.locals.familyId);
if (!Astro.locals.familyId && Astro.request.method === 'GET' && Astro.url.searchParams.has('new')) Astro.response.headers.set('Cache-Control', 'no-store');
const calendarCount = Astro.locals.familyId ? await db.$count(calendars, and(eq(calendars.userId, user.id), eq(calendars.familyId, Astro.locals.familyId))) : 0;
const isReturningUser = calendarCount > 0;
const inviteToken = Astro.url.searchParams.get('invite');
const inviteError = Astro.url.searchParams.get('error') === 'invite';
const csrfUrl = new URL('/api/auth/csrf', Astro.url);
const { Auth } = await import('@auth/core');
const { authConfig } = await import('../lib/auth');
const csrfResponse = await Auth(new Request(csrfUrl, { headers: Astro.request.headers }), authConfig);
const { csrfToken } = await csrfResponse.json() as { csrfToken: string };
const signInCallback = inviteToken ? `/welcome?invite=${encodeURIComponent(inviteToken)}` : '/welcome';
---

<Layout title="Get started" theme={theme}>
  <main class="mx-auto flex min-h-screen max-w-5xl items-center px-6 py-16"><div class="w-full">
    <div class="mb-10 max-w-2xl"><p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent">{isReturningUser ? 'Welcome back' : 'Let’s get started'}</p><h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{isReturningUser ? `Good to see you, ${user.name?.split(' ')[0] || 'there'}.` : 'Make KinBoard yours.'}</h1><p class="mt-4 text-lg leading-8 text-fg-muted">{isReturningUser ? 'Your dashboard is ready whenever you are.' : 'Connect your calendar and shape a dashboard that works for your household.'}</p></div>
    {inviteError && <p class="mb-5 rounded-xl bg-danger-soft p-4 text-danger">That invitation expired or is no longer valid. Ask a family member for a new QR invite.</p>}
    {user ? (Astro.locals.familyId ? <div class="grid gap-5 md:grid-cols-2"><a href="/" class="group rounded-3xl bg-surface p-6 shadow-card transition hover:-translate-y-1 hover:bg-surface-2"><div class="mb-8 text-4xl">🏠</div><h2 class="text-xl font-semibold">Open family dashboard</h2><p class="mt-2 text-fg-muted">See your family’s schedule, chores, meals, and notes.</p></a><a href="/admin/calendars" class="group rounded-3xl border border-line bg-surface p-6 shadow-card transition hover:-translate-y-1 hover:bg-surface-2"><div class="mb-8 text-4xl">✨</div><h2 class="text-xl font-semibold">{isReturningUser ? 'Manage setup' : 'Set up dashboard'}</h2><p class="mt-2 text-fg-muted">Connect calendars and add family details.</p></a></div> : <div class="grid gap-5 md:grid-cols-2"><section class="rounded-3xl bg-surface p-6 shadow-card"><div class="mb-5 text-4xl">👪</div><h2 class="text-xl font-semibold">Create a family</h2><p class="mt-2 mb-5 text-fg-muted">Start a shared dashboard and invite others with a QR code.</p><form method="POST" action="/api/family/create" class="space-y-3"><input name="name" placeholder="Family name" class="w-full rounded-xl border border-line bg-surface-2 px-3 py-2.5" /><button class="w-full rounded-xl bg-accent px-4 py-3 font-semibold text-white">Create family</button></form></section><section class="rounded-3xl border border-line bg-surface p-6 shadow-card"><div class="mb-5 text-4xl">📲</div><h2 class="text-xl font-semibold">Join a family</h2><p class="mt-2 mb-5 text-fg-muted">Scan an invite QR code or enter its invitation code.</p><form method="POST" action="/api/family/join" class="space-y-3"><input name="token" required value={inviteToken ?? ''} placeholder="Invite code" class="w-full rounded-xl border border-line bg-surface-2 px-3 py-2.5" /><button class="w-full rounded-xl border border-line bg-surface-2 px-4 py-3 font-semibold">Join family</button></form></section></div>) : <section class="mx-auto max-w-md rounded-3xl bg-surface p-8 shadow-card"><h2 class="text-2xl font-bold">Sign in to continue</h2><p class="mt-2 text-fg-muted">Use Google to create a family or accept its invite.</p><form class="mt-6" method="POST" action="/api/auth/signin/google"><input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="callbackUrl" value={signInCallback} /><button class="w-full rounded-xl bg-accent px-4 py-3 font-semibold text-white">Continue with Google</button></form></section>}
  </div></main>
</Layout>
