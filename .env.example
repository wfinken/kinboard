# Copy to .env and fill in values before running KinBoard.

# SQLite database file (local path or libsql:// / turso:// URL)
DATABASE_URL=file:./data/kinboard.db

# Generate with: openssl rand -base64 33
AUTH_SECRET=

# Google Cloud OAuth credentials (console.cloud.google.com -> APIs & Services -> Credentials)
# Add an "OAuth 2.0 Client ID" (Web application) with an authorized redirect URI of:
#   http(s)://<your-domain>/api/auth/callback/google
# and enable the "Google Calendar API" for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Coordinates for the weather widget (defaults to New York City if unset)
KINBOARD_LAT=40.7128
KINBOARD_LON=-74.0060
# "celsius" or "fahrenheit"
KINBOARD_TEMP_UNIT=celsius
